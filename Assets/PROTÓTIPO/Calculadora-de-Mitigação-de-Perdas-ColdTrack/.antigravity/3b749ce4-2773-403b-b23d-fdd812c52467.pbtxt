      replacement_content: "import { CalculoPerdasInput, CalculoPerdasResponse } from \'../types\';\n\nexport function formatarMoedaBRL(valor: number): string {\n  return valor.toLocaleString(\'pt-BR\', {\n    style: \'currency\',\n    currency: \'BRL\',\n    minimumFractionDigits: 2,\n    maximumFractionDigits: 2,\n  });\n}\n\nexport function formatarNumeroBR(valor: number, decimais = 2): string {\n  return valor.toLocaleString(\'pt-BR\', {\n    minimumFractionDigits: decimais,\n    maximumFractionDigits: decimais,\n  });\n}\n\n/**\n * Executa as regras de neg\303\263cio de c\303\241lculo de perdas log\303\255sticas e mitiga\303\247\303\243o por IoT preditivo.\n * \n * Passo 1: Valor Total da Carga = Peso Total * Valor M\303\251dio por KG\n * Passo 2: Falha T\303\251rmica = 12% fixo sobre o Valor Total da Carga\n * Passo 3: Falha de Umidade / Desidrata\303\247\303\243o = 2% do peso total evaporado * valor do KG\n * Passo 4: Valor Estimado de Desperd\303\255cio Evitado = Falha T\303\251rmica + Perda por Desidrata\303\247\303\243o\n */\nexport function calcularMitigacaoPerdas(input: CalculoPerdasInput): CalculoPerdasResponse {\n  const pesoTotalKg = Math.max(0, Number(input.pesoTotalKg) || 0);\n  const valorMedioKg = Math.max(0, Number(input.valorMedioKg) || 0);\n  const estadoMercadoria = input.estadoMercadoria === \'resfriada\' ? \'resfriada\' : \'congelada\';\n  const custoDispositivo = Math.max(0, Number(input.custoDispositivo ?? 2000));\n  const viagensMes = Math.max(1, Number(input.viagensMes ?? 12));\n\n  // Passo 1: C\303\241lculo do Valor Bruto\n  const valorTotalCarga = pesoTotalKg * valorMedioKg;\n\n  // Passo 2: Perda por Quebra da Cadeia do Frio (Falha T\303\251rmica)\n  // Perda fixa de 12% sobre o Valor Total da Carga\n  const taxaPerdaTermica = 0.12;\n  const perdaCadeiaFrio = valorTotalCarga * taxaPerdaTermica;\n\n  // Passo 3: Perda F\303\255sica por Desidrata\303\247\303\243o (Falha de Umidade)\n  // Perda de 2% (m\303\251dia de 1% a 3%) deduzida do peso total para encontrar o volume evaporado\n  const taxaPerdaDesidratacao = 0.02;\n  const pesoEvaporadoKg = pesoTotalKg * taxaPerdaDesidratacao;\n  const perdaDesidratacao = pesoEvaporadoKg * valorMedioKg;\n\n  // Passo 4: Retorno e Exibi\303\247\303\243o para o Usu\303\241rio\n  // Soma da Perda por Quebra T\303\251rmica + Perda Financeira por Desidrata\303\247\303\243o\n  const valorEstimadoDesperdicioEvitado = perdaCadeiaFrio + perdaDesidratacao;\n\n  // Evidencia\303\247\303\243o do estado \"Resfriada\" (carne in natura sofre grande impacto h\303\255drico)\n  const isResfriada = estadoMercadoria === \'resfriada\';\n  const destaqueResfriada = {\n    ativo: isResfriada,\n    titulo: isResfriada \n      ? \'Aten\303\247\303\243o Cr\303\255tica: Carga Resfriada (In Natura)\' \n      : \'Carga Congelada: Controle Preventivo\',\n    descricao: isResfriada\n      ? `A prote\303\255na in natura resfriada possui alta atividade de \303\241gua superficial. O desvio dos n\303\255veis ideais de umidade relativa causa evapora\303\247\303\243o h\303\255drica direta, subtraindo peso na balan\303\247a do entreposto.`\n      : `Em cargas congeladas, a umidade controlada impede a forma\303\247\303\243o de gelo excessivo e queima por frio (freezer burn), preservando a textura e o peso original.`,\n    avisoTecnico: isResfriada\n      ? `Impacto H\303\255drico Calculado: ${formatarNumeroBR(pesoEvaporadoKg, 1)} kg de \303\241gua evaporada por viagem (${formatarMoedaBRL(perdaDesidratacao)} perdidos por \"carne mais leve\").`\n      : `Impacto T\303\251rmico e H\303\255drico: Perda prevenida de ${formatarNumeroBR(pesoEvaporadoKg, 1)} kg de peso com reten\303\247\303\243o de umidade em -18\302\260C.`,\n    pesoEvaporadoFormatado: `${formatarNumeroBR(pesoEvaporadoKg, 1)} kg`,\n    impactoFinanceiroFormatado: formatarMoedaBRL(perdaDesidratacao),\n  };\n\n  const economiaLiquidaPrimeiraViagem = valorEstimadoDesperdicioEvitado - custoDispositivo;\n  const roiMultiplicador = custoDispositivo > 0 ? (valorEstimadoDesperdicioEvitado / custoDispositivo) : 0;\n  const paybackViagens = valorEstimadoDesperdicioEvitado > 0 ? Math.ceil(custoDispositivo / valorEstimadoDesperdicioEvitado) : 1;\n\n  const desperdicioMensalEstimado = valorEstimadoDesperdicioEvitado * viagensMes;\n  const desperdicioAnualEstimado = desperdicioMensalEstimado * 12;\n\n  return {\n    valorTotalCarga,\n    perdaCadeiaFrio,\n    taxaPerdaTermica,\n    taxaPerdaDesidratacao,\n    pesoEvaporadoKg,\n    perdaDesidratacao,\n    valorEstimadoDesperdicioEvitado,\n    detalhamento: {\n      salvoQuebraTermica: perdaCadeiaFrio,\n      salvoDesidratacaoUmidade: perdaDesidratacao,\n      percentualTermico: taxaPerdaTermica * 100, // 12%\n      percentualUmidade: taxaPerdaDesidratacao * 100, // 2%\n      pesoEvaporadoKg,\n    },\n    estadoMercadoria,\n    pesoTotalKg,\n    valorMedioKg,\n    destaqueResfriada,\n    metricasComplementares: {\n      custoDispositivo,\n      economiaLiquidaPrimeiraViagem,\n      roiMultiplicador,\n      paybackViagens,\n      desperdicioMensalEstimado,\n      desperdicioAnualEstimado,\n    },\n  };\n}\n"
    }
