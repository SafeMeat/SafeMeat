  file_change {
    absolute_path_uri: "file:///src/components/PresentationModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { X, ChevronLeft, ChevronRight, CheckCircle2, ShieldAlert, Cpu, Database, TrendingUp, Download } from \'lucide-react\';\nimport { SafeMeatLogo } from \'./SafeMeatLogo\';\n\ninterface PresentationModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onOpenCalculator?: () => void;\n}\n\nexport const PresentationModal: React.FC<PresentationModalProps> = ({\n  isOpen,\n  onClose,\n  onOpenCalculator,\n}) => {\n  const [slideAtual, setSlideAtual] = useState(0);\n\n  if (!isOpen) return null;\n\n  const slides = [\n    {\n      titulo: \'O Desafio Cr\303\255tico no Transporte de Prote\303\255na Animal\',\n      subtitulo: \'Perdas invis\303\255veis que corroem as margens de frigor\303\255ficos e distribuidores\',\n      icone: <ShieldAlert className=\"w-8 h-8 text-amber-500\" />,\n      conteudo: (\n        <div className=\"space-y-4\">\n          <p className=\"text-sm text-slate-700 leading-relaxed\">\n            No Brasil, estat\303\255sticas log\303\255sticas comprovam que aproximadamente <strong>12% dos alimentos perec\303\255veis</strong> sofrem perdas durante o frete por falhas e quebras t\303\251rmicas no sistema de refrigera\303\247\303\243o.\n          </p>\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 my-3\">\n            <div className=\"p-4 rounded-xl bg-red-50/80 border border-red-200\">\n              <div className=\"text-2xl font-black text-red-600 font-mono\">12% Perda T\303\251rmica</div>\n              <p className=\"text-xs text-slate-700 mt-1\">\n                Descarte total ou desclassifica\303\247\303\243o sanit\303\241ria de cortes nobres por flutua\303\247\303\243o t\303\251rmica acima de 4\302\260C.\n              </p>\n            </div>\n            <div className=\"p-4 rounded-xl bg-amber-50/80 border border-amber-200\">\n              <div className=\"text-2xl font-black text-amber-600 font-mono\">2% Quebra H\303\255drica</div>\n              <p className=\"text-xs text-slate-700 mt-1\">\n                Desidrata\303\247\303\243o e perda de peso da carne resfriada quando a umidade e a ventila\303\247\303\243o do ba\303\272 descalibram.\n              </p>\n            </div>\n          </div>\n          <p className=\"text-xs text-slate-500 italic\">\n            Fonte: Dados de auditorias da cadeia log\303\255stica e an\303\241lises do agroneg\303\263cio nacional.\n          </p>\n        </div>\n      ),\n    },\n    {\n      titulo: \'A Resposta Tecnol\303\263gica: Dispositivo IoT Safe Meat\',\n      subtitulo: \'Sensores de alta precis\303\243o em pontos estrat\303\251gicos da carga frigorificada\',\n      icone: <Cpu className=\"w-8 h-8 text-cyan-500\" />,\n      conteudo: (\n        <div className=\"space-y-4\">\n          <p className=\"text-sm text-slate-700 leading-relaxed\">\n            Desenvolvido sob padr\303\265es industriais rigorosos, o dispositivo Safe Meat opera com sensores redundantes na cabine e no interior do ba\303\272 frigor\303\255fico:\n          </p>\n          <ul className=\"space-y-2.5 text-xs text-slate-700\">\n            <li className=\"flex items-start gap-2\">\n              <CheckCircle2 className=\"w-4 h-4 text-cyan-600 mt-0.5 shrink-0\" />\n              <span><strong>Monitoramento Cont\303\255nuo (0\302\260C a 4\302\260C):</strong> Leitura calibrada para carne resfriada e temperaturas negativas para congelados.</span>\n            </li>\n            <li className=\"flex items-start gap-2\">\n              <CheckCircle2 className=\"w-4 h-4 text-cyan-600 mt-0.5 shrink-0\" />\n              <span><strong>Telemetria a Cada 15 Segundos:</strong> Envio de pulsos higrot\303\251rmicos via rede de celular industrial (LTE-M / NB-IoT).</span>\n            </li>\n            <li className=\"flex items-start gap-2\">\n              <CheckCircle2 className=\"w-4 h-4 text-cyan-600 mt-0.5 shrink-0\" />\n              <span><strong>Alertas Preditivos:</strong> Notifica\303\247\303\243o autom\303\241tica ao motorista e \303\240 central de monitoramento 45 minutos antes do ponto cr\303\255tico de degrada\303\247\303\243o.</span>\n            </li>\n          </ul>\n        </div>\n      ),\n    },\n    {\n      titulo: \'Arquitetura Edge Computing e Compliance\',\n      subtitulo: \'Seguran\303\247a absoluta de dados mesmo em trechos remotos sem sinal de telefonia\',\n      icone: <Database className=\"w-8 h-8 text-blue-600\" />,\n      conteudo: (\n        <div className=\"space-y-4\">\n          <p className=\"text-sm text-slate-700 leading-relaxed\">\n            O hardware processa e armazena os dados localmente (Edge). Ao trafegar por rodovias sem cobertura de celular, nada se perde:\n          </p>\n          <div className=\"p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-2 text-xs text-slate-700\">\n            <div className=\"flex items-center gap-2 text-slate-900 font-bold\">\n              <div className=\"w-2 h-2 rounded-full bg-emerald-500\"></div>\n              <span>Buffer Local Criptografado de at\303\251 30 dias de viagem</span>\n            </div>\n            <p className=\"text-slate-600\">\n              Sincroniza\303\247\303\243o imediata em lote assim que o ve\303\255culo atinge cobertura de rede ou ponto de descarregamento com Wi-Fi.\n            </p>\n            <div className=\"flex items-center gap-2 text-slate-900 font-bold pt-1\">\n              <div className=\"w-2 h-2 rounded-full bg-blue-500\"></div>\n              <span>Laudo Sanit\303\241rio Digital Instant\303\242neo</span>\n            </div>\n            <p className=\"text-slate-600\">\n              Relat\303\263rio de conformidade audit\303\241vel para fiscais do MAPA (Minist\303\251rio da Agricultura e Pecu\303\241ria) e SIF no momento do recebimento.\n            </p>\n          </div>\n        </div>\n      ),\n    },\n    {\n      titulo: \'Impacto Financeiro e Blindagem de Marca\',\n      subtitulo: \'O ROI da mitiga\303\247\303\243o de riscos e a preserva\303\247\303\243o do valor da sua prote\303\255na\',\n      icone: <TrendingUp className=\"w-8 h-8 text-emerald-600\" />,\n      conteudo: (\n        <div className=\"space-y-4\">\n          <p className=\"text-sm text-slate-700 leading-relaxed\">\n            Em uma \303\272nica carreta com 20.000 kg de carne bovina, a perda evitada pode ultrapassar dezenas de milhares de reais por viagem.\n          </p>\n          <div className=\"p-4 rounded-xl bg-emerald-50 border border-emerald-200\">\n            <div className=\"text-xs font-bold text-emerald-900 uppercase tracking-wider mb-1\">\n              Economia Imediata no Primeiro M\303\252s\n            </div>\n            <p className=\"text-xs text-emerald-800 leading-relaxed\">\n              Ao interceptar a falha do compressor ou o desligamento indevido do motor frigor\303\255fico em tempo h\303\241bil, a Safe Meat se paga j\303\241 na primeira ocorr\303\252ncia mitigada.\n            </p>\n          </div>\n          {onOpenCalculator && (\n            <div className=\"pt-2 text-center\">\n              <button\n                type=\"button\"\n                onClick={() => {\n                  onClose();\n                  onOpenCalculator();\n                }}\n                className=\"px-5 py-2.5 rounded-xl bg-blue-900 hover:bg-blue-800 text-white text-xs font-bold uppercase tracking-wider transition-colors inline-flex items-center gap-2\"\n              >\n                <span>Calcular Economia da Minha Carga</span>\n                <ChevronRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          )}\n        </div>\n      ),\n    },\n  ];\n\n  const slide = slides[slideAtual];\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-xs animate-fade-in select-none\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"presentation-title\"\n    >\n      <div className=\"relative w-full max-w-2xl bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden text-slate-900\">\n        \n        {/* Barra de controle superior */}\n        <div className=\"bg-[#070D18] text-white px-6 py-4 flex items-center justify-between border-b border-slate-800\">\n          <div className=\"flex items-center gap-3\">\n            <SafeMeatLogo variant=\"horizontal\" darkBg={true} />\n            <span className=\"hidden sm:inline-block text-xs font-mono text-cyan-400 border-l border-slate-700 pl-3\">\n              Pitch Executivo B2B\n            </span>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors\"\n            aria-label=\"Fechar apresenta\303\247\303\243o\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Conte\303\272do do Slide */}\n        <div className=\"p-6 sm:p-8 min-h-[340px] flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center gap-3 mb-3\">\n              <div className=\"p-2 rounded-xl bg-slate-100 shrink-0\">\n                {slide.icone}\n              </div>\n              <div>\n                <span className=\"text-[11px] font-mono text-cyan-700 uppercase font-bold tracking-wider\">\n                  Slide {slideAtual + 1} de {slides.length}\n                </span>\n                <h3 id=\"presentation-title\" className=\"text-xl font-bold text-slate-900\">\n                  {slide.titulo}\n                </h3>\n              </div>\n            </div>\n\n            <p className=\"text-xs text-slate-500 font-medium mb-5\">\n              {slide.subtitulo}\n            </p>\n\n            {slide.conteudo}\n          </div>\n\n          {/* Navega\303\247\303\243o entre slides */}\n          <div className=\"mt-8 pt-5 border-t border-slate-200 flex items-center justify-between\">\n            <div className=\"flex items-center gap-1.5\">\n              {slides.map((_, idx) => (\n                <button\n                  key={idx}\n                  type=\"button\"\n                  onClick={() => setSlideAtual(idx)}\n                  className={`h-2 rounded-full transition-all duration-300 ${\n                    idx === slideAtual ? \'w-8 bg-cyan-600\' : \'w-2 bg-slate-300 hover:bg-slate-400\'\n                  }`}\n                  aria-label={`Ir para slide ${idx + 1}`}\n                />\n              ))}\n            </div>\n\n            <div className=\"flex items-center gap-2\">\n              <button\n                type=\"button\"\n                disabled={slideAtual === 0}\n                onClick={() => setSlideAtual((prev) => Math.max(0, prev - 1))}\n                className=\"p-2 rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-100 disabled:opacity-30 disabled:cursor-not-allowed transition-colors\"\n                aria-label=\"Slide anterior\"\n              >\n                <ChevronLeft className=\"w-4 h-4\" />\n              </button>\n\n              {slideAtual < slides.length - 1 ? (\n                <button\n                  type=\"button\"\n                  onClick={() => setSlideAtual((prev) => Math.min(slides.length - 1, prev + 1))}\n                  className=\"px-4 py-2 rounded-lg bg-blue-900 hover:bg-blue-800 text-white text-xs font-bold uppercase tracking-wider flex items-center gap-1 transition-colors\"\n                >\n                  <span>Pr\303\263ximo</span>\n                  <ChevronRight className=\"w-4 h-4\" />\n                </button>\n              ) : (\n                <button\n                  type=\"button\"\n                  onClick={onClose}\n                  className=\"px-4 py-2 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 text-xs font-bold uppercase tracking-wider transition-colors\"\n                >\n                  Fechar\n                </button>\n              )}\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    }
