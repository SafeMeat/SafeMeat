  file_change {
    absolute_path_uri: "file:///src/components/SafeMeatLogo.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\n\ninterface SafeMeatLogoProps {\n  variant?: \'full\' | \'horizontal\' | \'compact\' | \'badge\';\n  size?: \'sm\' | \'md\' | \'lg\' | \'xl\';\n  darkBg?: boolean;\n  className?: string;\n}\n\nexport const SafeMeatLogo: React.FC<SafeMeatLogoProps> = ({\n  variant = \'horizontal\',\n  size = \'md\',\n  darkBg = false,\n  className = \'\',\n}) => {\n  // Cores institucionais fi\303\251is ao logotipo\n  const navyColor = darkBg ? \'#FFFFFF\' : \'#0B2545\';\n  const redColor = \'#A11E22\';\n  const blueCold = \'#1E6FB5\';\n  const cyanAccent = \'#00C2FF\';\n\n  if (variant === \'badge\' || variant === \'full\') {\n    return (\n      <div className={`flex flex-col items-center select-none ${className}`}>\n        {/* Emblema / Escudo com Term\303\264metro, Floco de Neve, Corte de Carne e Caminh\303\243o Frigor\303\255fico */}\n        <div className=\"relative flex items-center justify-center\">\n          <svg\n            viewBox=\"0 0 400 360\"\n            className={`${\n              size === \'sm\' ? \'w-24 h-24\' :\n              size === \'md\' ? \'w-40 h-36\' :\n              size === \'lg\' ? \'w-56 h-50\' : \'w-72 h-64\'\n            } drop-shadow-md`}\n            fill=\"none\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n          >\n            <defs>\n              {/* Gradiente do Escudo */}\n              <linearGradient id=\"shieldGrad\" x1=\"50\" y1=\"20\" x2=\"350\" y2=\"300\" gradientUnits=\"userSpaceOnUse\">\n                <stop offset=\"0%\" stopColor=\"#1E5AA0\" />\n                <stop offset=\"50%\" stopColor=\"#0D3268\" />\n                <stop offset=\"100%\" stopColor=\"#0B2545\" />\n              </linearGradient>\n\n              {/* Gradiente Frio Neon */}\n              <linearGradient id=\"coldGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n                <stop offset=\"0%\" stopColor=\"#00F0FF\" />\n                <stop offset=\"100%\" stopColor=\"#1E6FB5\" />\n              </linearGradient>\n\n              {/* Gradiente Carne */}\n              <linearGradient id=\"meatGrad\" x1=\"190\" y1=\"80\" x2=\"280\" y2=\"170\" gradientUnits=\"userSpaceOnUse\">\n                <stop offset=\"0%\" stopColor=\"#C92A2A\" />\n                <stop offset=\"60%\" stopColor=\"#A11E22\" />\n                <stop offset=\"100%\" stopColor=\"#670000\" />\n              </linearGradient>\n\n              {/* Sombra suave */}\n              <filter id=\"glow\" x=\"-10%\" y=\"-10%\" width=\"120%\" height=\"120%\">\n                <feDropShadow dx=\"0\" dy=\"2\" stdDeviation=\"4\" floodColor=\"#00C2FF\" floodOpacity=\"0.25\" />\n              </filter>\n            </defs>\n\n            {/* Orbit / Arco de telemetria frio ao redor */}\n            <path\n              d=\"M 50 160 C 40 210, 100 250, 200 255 C 320 255, 360 190, 340 145 C 335 135, 320 135, 315 145 C 300 185, 260 220, 190 220 C 130 220, 90 180, 100 150 Z\"\n              fill=\"url(#coldGrad)\"\n              opacity=\"0.85\"\n            />\n\n            {/* Contorno do Escudo */}\n            <path\n              d=\"M 200 25 C 270 50, 315 50, 315 130 C 315 220, 230 280, 200 300 C 170 280, 85 220, 85 130 C 85 50, 130 50, 200 25 Z\"\n              fill={darkBg ? \'#0F1E36\' : \'#FFFFFF\'}\n              stroke=\"url(#shieldGrad)\"\n              strokeWidth=\"16\"\n              strokeLinejoin=\"round\"\n            />\n\n            {/* Linha interna do escudo */}\n            <path\n              d=\"M 200 45 C 255 68, 295 68, 295 135 C 295 210, 225 265, 200 280 C 175 265, 105 210, 105 135 C 105 68, 145 68, 200 45 Z\"\n              fill={darkBg ? \'#081224\' : \'#F0F6FF\'}\n              stroke=\"#00C2FF\"\n              strokeWidth=\"2.5\"\n              strokeDasharray=\"4 4\"\n              opacity=\"0.6\"\n            />\n\n            {/* Floco de Neve (Lado Esquerdo Superior) */}\n            <g transform=\"translate(135, 110) scale(0.7)\" stroke=\"#2298F5\" strokeWidth=\"4\" strokeLinecap=\"round\">\n              <line x1=\"0\" y1=\"-28\" x2=\"0\" y2=\"28\" />\n              <line x1=\"-24\" y1=\"-14\" x2=\"24\" y2=\"14\" />\n              <line x1=\"-24\" y1=\"14\" x2=\"24\" y2=\"-14\" />\n              {/* Ramifica\303\247\303\265es */}\n              <path d=\"M -6 -18 L 0 -22 L 6 -18\" fill=\"none\" />\n              <path d=\"M -6 18 L 0 22 L 6 18\" fill=\"none\" />\n              <path d=\"M -18 -4 L -20 -10 L -12 -12\" fill=\"none\" />\n              <path d=\"M 18 4 L 20 10 L 12 12\" fill=\"none\" />\n              <path d=\"M -18 4 L -20 10 L -12 12\" fill=\"none\" />\n              <path d=\"M 18 -4 L 20 -10 L 12 -12\" fill=\"none\" />\n            </g>\n\n            {/* Corte de Prote\303\255na / Bife Marmorizado (Lado Direito) */}\n            <g transform=\"translate(195, 75) scale(0.95)\">\n              <path\n                d=\"M 40 10 C 65 5, 90 25, 92 55 C 94 85, 70 115, 45 118 C 20 120, 5 105, 5 80 C 5 50, 15 15, 40 10 Z\"\n                fill=\"url(#meatGrad)\"\n                stroke=\"#FFFFFF\"\n                strokeWidth=\"4\"\n              />\n              {/* Marmoreio branco da carne */}\n              <path\n                d=\"M 35 30 C 50 35, 60 55, 50 75 C 45 85, 30 85, 32 70 C 35 55, 45 45, 35 30\"\n                fill=\"none\"\n                stroke=\"#FFFFFF\"\n                strokeWidth=\"4\"\n                strokeLinecap=\"round\"\n                opacity=\"0.9\"\n              />\n              <path\n                d=\"M 65 40 C 75 55, 75 75, 68 90\"\n                fill=\"none\"\n                stroke=\"#FFFFFF\"\n                strokeWidth=\"3.5\"\n                strokeLinecap=\"round\"\n                opacity=\"0.8\"\n              />\n            </g>\n\n            {/* Term\303\264metro Central de Precis\303\243o */}\n            <g transform=\"translate(170, 50)\">\n              {/* Tubo externo do term\303\264metro */}\n              <rect x=\"18\" y=\"5\" width=\"24\" height=\"110\" rx=\"12\" fill=\"#FFFFFF\" stroke=\"#0B2545\" strokeWidth=\"4.5\" />\n              {/* Bulbo inferior */}\n              <circle cx=\"30\" cy=\"120\" r=\"22\" fill=\"#FFFFFF\" stroke=\"#0B2545\" strokeWidth=\"4.5\" />\n              \n              {/* L\303\255quido azul frio */}\n              <rect x=\"23\" y=\"45\" width=\"14\" height=\"70\" rx=\"7\" fill=\"url(#coldGrad)\" />\n              <circle cx=\"30\" cy=\"120\" r=\"16\" fill=\"url(#coldGrad)\" />\n\n              {/* Marca\303\247\303\265es do term\303\264metro */}\n              <line x1=\"38\" y1=\"25\" x2=\"44\" y2=\"25\" stroke=\"#0B2545\" strokeWidth=\"2.5\" strokeLinecap=\"round\" />\n              <line x1=\"38\" y1=\"40\" x2=\"46\" y2=\"40\" stroke=\"#0B2545\" strokeWidth=\"2.5\" strokeLinecap=\"round\" />\n              <line x1=\"38\" y1=\"55\" x2=\"44\" y2=\"55\" stroke=\"#0B2545\" strokeWidth=\"2.5\" strokeLinecap=\"round\" />\n              <line x1=\"38\" y1=\"70\" x2=\"46\" y2=\"70\" stroke=\"#0B2545\" strokeWidth=\"2.5\" strokeLinecap=\"round\" />\n              <line x1=\"38\" y1=\"85\" x2=\"44\" y2=\"85\" stroke=\"#0B2545\" strokeWidth=\"2.5\" strokeLinecap=\"round\" />\n              \n              {/* Ponto de luz no bulbo */}\n              <circle cx=\"26\" cy=\"115\" r=\"4\" fill=\"#FFFFFF\" opacity=\"0.7\" />\n            </g>\n\n            {/* Caminh\303\243o Frigor\303\255fico em Rota (Sobreposto na base do escudo) */}\n            <g transform=\"translate(190, 160) scale(0.9)\">\n              {/* Sombra do caminh\303\243o */}\n              <ellipse cx=\"75\" cy=\"98\" rx=\"80\" ry=\"8\" fill=\"#000000\" opacity=\"0.25\" />\n\n              {/* Ba\303\272 Refrigerado */}\n              <rect x=\"0\" y=\"10\" width=\"85\" height=\"68\" rx=\"4\" fill=\"#FFFFFF\" stroke=\"#0B2545\" strokeWidth=\"4\" />\n              {/* Floco de Neve no ba\303\272 frigor\303\255fico */}\n              <g transform=\"translate(42, 44) scale(0.55)\" stroke=\"#1E6FB5\" strokeWidth=\"4\" strokeLinecap=\"round\">\n                <line x1=\"0\" y1=\"-22\" x2=\"0\" y2=\"22\" />\n                <line x1=\"-19\" y1=\"-11\" x2=\"19\" y2=\"11\" />\n                <line x1=\"-19\" y1=\"11\" x2=\"19\" y2=\"-11\" />\n                <path d=\"M -5 -14 L 0 -18 L 5 -14\" fill=\"none\" />\n                <path d=\"M -5 14 L 0 18 L 5 14\" fill=\"none\" />\n              </g>\n\n              {/* Cabine do Caminh\303\243o */}\n              <path\n                d=\"M 85 28 L 110 28 C 118 28, 128 35, 134 45 L 142 62 C 145 68, 145 74, 145 78 L 85 78 Z\"\n                fill=\"#FFFFFF\"\n                stroke=\"#0B2545\"\n                strokeWidth=\"4\"\n              />\n              {/* Para-brisa */}\n              <path\n                d=\"M 96 35 L 115 35 C 122 35, 128 40, 132 48 L 135 55 L 96 55 Z\"\n                fill=\"#1E3E62\"\n              />\n              {/* Farol */}\n              <rect x=\"138\" y=\"65\" width=\"6\" height=\"8\" rx=\"2\" fill=\"#00F0FF\" />\n              {/* Grade */}\n              <rect x=\"110\" y=\"64\" width=\"22\" height=\"10\" rx=\"2\" fill=\"#0B2545\" />\n\n              {/* Rodas */}\n              <g transform=\"translate(25, 78)\">\n                <circle cx=\"0\" cy=\"0\" r=\"13\" fill=\"#0B2545\" />\n                <circle cx=\"0\" cy=\"0\" r=\"6\" fill=\"#D6DBE6\" />\n              </g>\n              <g transform=\"translate(108, 78)\">\n                <circle cx=\"0\" cy=\"0\" r=\"13\" fill=\"#0B2545\" />\n                <circle cx=\"0\" cy=\"0\" r=\"6\" fill=\"#D6DBE6\" />\n              </g>\n\n              {/* Linhas de movimento e velocidade */}\n              <line x1=\"-30\" y1=\"45\" x2=\"-8\" y2=\"45\" stroke=\"#00C2FF\" strokeWidth=\"3.5\" strokeLinecap=\"round\" />\n              <line x1=\"-20\" y1=\"58\" x2=\"-5\" y2=\"58\" stroke=\"#1E6FB5\" strokeWidth=\"3\" strokeLinecap=\"round\" />\n              <line x1=\"-35\" y1=\"70\" x2=\"-10\" y2=\"70\" stroke=\"#00C2FF\" strokeWidth=\"2.5\" strokeLinecap=\"round\" />\n            </g>\n          </svg>\n        </div>\n\n        {/* Tipografia da Marca: Safe em Azul Marinho, Meat em Vermelho */}\n        <div className=\"mt-2 text-center\">\n          <div className=\"flex items-baseline justify-center tracking-tight font-black\">\n            <span\n              className={`font-black tracking-tight ${\n                size === \'sm\' ? \'text-2xl\' :\n                size === \'md\' ? \'text-4xl\' :\n                size === \'lg\' ? \'text-5xl\' : \'text-6xl\'\n              }`}\n              style={{ color: navyColor, fontFamily: \'Inter, system-ui, sans-serif\' }}\n            >\n              Safe\n            </span>\n            <span\n              className={`font-black tracking-tight ${\n                size === \'sm\' ? \'text-2xl\' :\n                size === \'md\' ? \'text-4xl\' :\n                size === \'lg\' ? \'text-5xl\' : \'text-6xl\'\n              }`}\n              style={{ color: redColor, fontFamily: \'Inter, system-ui, sans-serif\' }}\n            >\n              Meat\n            </span>\n          </div>\n\n          {/* Divisor com floco de neve */}\n          <div className=\"flex items-center justify-center gap-3 my-1.5 w-full max-w-[260px] mx-auto opacity-90\">\n            <div className=\"h-[1.5px] flex-1 bg-gradient-to-r from-transparent via-[#1E6FB5] to-[#1E6FB5]\"></div>\n            <svg className=\"w-4 h-4 text-[#1E6FB5]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\">\n              <line x1=\"12\" y1=\"2\" x2=\"12\" y2=\"22\" />\n              <line x1=\"2\" y1=\"12\" x2=\"22\" y2=\"12\" />\n              <line x1=\"4.93\" y1=\"4.93\" x2=\"19.07\" y2=\"19.07\" />\n              <line x1=\"4.93\" y1=\"19.07\" x2=\"19.07\" y2=\"4.93\" />\n            </svg>\n            <div className=\"h-[1.5px] flex-1 bg-gradient-to-l from-transparent via-[#1E6FB5] to-[#1E6FB5]\"></div>\n          </div>\n\n          {/* Slogans Oficiais */}\n          <div className=\"space-y-0.5\">\n            <div\n              className={`text-[9px] sm:text-[10px] tracking-[0.22em] font-bold uppercase ${\n                darkBg ? \'text-slate-300\' : \'text-[#0B2545]\'\n              }`}\n            >\n              Seguran\303\247a e Qualidade em Cada Grau\n            </div>\n            <div className=\"text-[8px] sm:text-[9px] tracking-[0.25em] font-bold uppercase text-[#A11E22]\">\n              Controle Inteligente da Cadeia de Frio\n            </div>\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  // Vers\303\243o Horizontal para Header / Barra de Navega\303\247\303\243o\n  return (\n    <div className={`flex items-center gap-2.5 select-none ${className}`}>\n      {/* Mini Emblema Vetorial */}\n      <div className=\"relative w-9 h-9 rounded-lg bg-gradient-to-br from-blue-900 via-slate-900 to-slate-950 p-1 flex items-center justify-center shadow-xs border border-cyan-500/30 shrink-0\">\n        <svg viewBox=\"0 0 100 100\" className=\"w-full h-full\" fill=\"none\">\n          {/* Escudo mini */}\n          <path\n            d=\"M 50 8 C 75 18, 90 20, 90 50 C 90 78, 60 92, 50 96 C 40 92, 10 78, 10 50 C 10 20, 25 18, 50 8 Z\"\n            fill=\"#0B2545\"\n            stroke=\"#00C2FF\"\n            strokeWidth=\"4\"\n          />\n          {/* Term\303\264metro */}\n          <rect x=\"46\" y=\"24\" width=\"8\" height=\"36\" rx=\"4\" fill=\"#FFFFFF\" />\n          <circle cx=\"50\" cy=\"64\" r=\"8\" fill=\"#00F0FF\" />\n          <rect x=\"48\" y=\"38\" width=\"4\" height=\"26\" fill=\"#00F0FF\" />\n          {/* Floco de neve mini */}\n          <g transform=\"translate(28, 38) scale(0.35)\" stroke=\"#00F0FF\" strokeWidth=\"4\">\n            <line x1=\"0\" y1=\"-18\" x2=\"0\" y2=\"18\" />\n            <line x1=\"-15\" y1=\"0\" x2=\"15\" y2=\"0\" />\n          </g>\n          {/* Carne mini */}\n          <path\n            d=\"M 64 34 C 74 34, 78 44, 72 52 C 66 58, 58 54, 60 44 Z\"\n            fill=\"#A11E22\"\n          />\n        </svg>\n        {/* Glow neon discreto */}\n        <div className=\"absolute -inset-0.5 rounded-lg bg-cyan-400/20 blur-[2px] -z-10\"></div>\n      </div>\n\n      {/* Tipografia */}\n      <div className=\"flex flex-col\">\n        <div className=\"flex items-baseline tracking-tight font-black leading-none\">\n          <span\n            className=\"text-lg font-black tracking-tight\"\n            style={{ color: navyColor, fontFamily: \'Inter, system-ui, sans-serif\' }}\n          >\n            Safe\n          </span>\n          <span\n            className=\"text-lg font-black tracking-tight\"\n            style={{ color: redColor, fontFamily: \'Inter, system-ui, sans-serif\' }}\n          >\n            Meat\n          </span>\n        </div>\n        <span className=\"text-[8px] tracking-[0.16em] uppercase font-bold text-cyan-500 mt-0.5 leading-none\">\n          Cadeia do Frio IoT\n        </span>\n      </div>\n    </div>\n  );\n};\n"
    }
