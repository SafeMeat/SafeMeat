    replacement_chunks {
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { SafeMeatLogo } from \'./SafeMeatLogo\';\n\ninterface SplashAnimationProps {\n  onComplete: () => void;\n  duracaoMs?: number;\n}\n\nexport const SplashAnimation: React.FC<SplashAnimationProps> = ({\n  onComplete,\n  duracaoMs = 1500,\n}) => {\n  const [fase, setFase] = useState<\'visivel\' | \'desvanecendo\' | \'oculto\'>(\'visivel\');\n\n  useEffect(() => {\n    // Ap\303\263s a dura\303\247\303\243o exata (1.5s), inicia o desvanecimento suave\n    const timerFade = setTimeout(() => {\n      setFase(\'desvanecendo\');\n    }, duracaoMs);\n\n    // Conclui e desmonta o overlay ap\303\263s a transi\303\247\303\243o\n    const timerComplete = setTimeout(() => {\n      setFase(\'oculto\');\n      onComplete();\n    }, duracaoMs + 500);\n\n    return () => {\n      clearTimeout(timerFade);\n      clearTimeout(timerComplete);\n    };\n  }, [duracaoMs, onComplete]);\n\n  if (fase === \'oculto\') return null;\n\n  return (\n    <div\n      className={`fixed inset-0 z-50 flex flex-col items-center justify-center bg-[#070D18] text-white transition-opacity duration-500 ease-out select-none ${\n        fase === \'desvanecendo\' ? \'opacity-0 pointer-events-none\' : \'opacity-100\'\n      }`}\n      role=\"alert\"\n      aria-label=\"Carregando Safe Meat\"\n    >\n      {/* Luz ambiente de refrigera\303\247\303\243o e telemetria */}\n      <div className=\"absolute inset-0 overflow-hidden pointer-events-none\">\n        <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-cyan-500/10 rounded-full blur-3xl animate-pulse\"></div>\n        <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[280px] h-[280px] bg-blue-600/15 rounded-full blur-2xl\"></div>\n        {/* Linhas de grade sutis de telemetria fria */}\n        <div \n          className=\"absolute inset-0 opacity-[0.03]\"\n          style={{\n            backgroundImage: `linear-gradient(to right, #ffffff 1px, transparent 1px), linear-gradient(to bottom, #ffffff 1px, transparent 1px)`,\n            backgroundSize: \'36px 36px\',\n          }}\n        ></div>\n      </div>\n\n      {/* Conte\303\272do Central: Logo + Slogan */}\n      <div className=\"relative z-10 flex flex-col items-center px-4 max-w-lg text-center animate-fade-in\">\n        {/* Logo completa com anima\303\247\303\243o suave */}\n        <div className=\"transform transition-transform duration-1000 scale-95 hover:scale-100\">\n          <SafeMeatLogo variant=\"badge\" size=\"lg\" darkBg={true} />\n        </div>\n\n        {/* Indicador de carregamento de telemetria */}\n        <div className=\"mt-8 flex flex-col items-center gap-2\">\n          <div className=\"w-44 h-1 bg-slate-800 rounded-full overflow-hidden border border-slate-700/60\">\n            <div \n              className=\"h-full bg-gradient-to-r from-blue-500 via-cyan-400 to-emerald-400 rounded-full transition-all duration-1000 ease-out\"\n              style={{\n                width: fase === \'desvanecendo\' ? \'100%\' : \'80%\',\n              }}\n            ></div>\n          </div>\n          <span className=\"text-[11px] font-mono tracking-wider text-cyan-400/80 uppercase\">\n            Iniciando Telemetria IoT...\n          </span>\n        </div>\n      </div>\n\n      {/* Bot\303\243o sutil para pular instantaneamente se o usu\303\241rio preferir */}\n      <button\n        type=\"button\"\n        onClick={() => {\n          setFase(\'desvanecendo\');\n          setTimeout(onComplete, 150);\n        }}\n        className=\"absolute bottom-6 right-6 text-xs text-slate-500 hover:text-slate-300 font-medium px-3 py-1.5 rounded border border-slate-800 bg-slate-900/60 transition-colors\"\n      >\n        Pular introdu\303\247\303\243o &rarr;\n      </button>\n    </div>\n  );\n};\n"
    }
