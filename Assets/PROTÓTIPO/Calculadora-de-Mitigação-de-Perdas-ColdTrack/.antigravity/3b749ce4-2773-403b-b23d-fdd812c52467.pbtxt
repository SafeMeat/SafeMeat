    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ArrowRight, Play, Shield, Thermometer, Radio, CheckCircle2, ChevronDown } from \'lucide-react\';\n\ninterface HeroSectionProps {\n  onExploreSolution: () => void;\n  onOpenPresentation: () => void;\n}\n\nexport const HeroSection: React.FC<HeroSectionProps> = ({\n  onExploreSolution,\n  onOpenPresentation,\n}) => {\n  return (\n    <section\n      className=\"relative min-h-[92vh] flex items-center justify-center pt-24 pb-16 overflow-hidden bg-[#070D18]\"\n      aria-label=\"Banner Principal Safe Meat\"\n    >\n      {/* Camada de Fundo: Imagem Vetorial & Gradiente Tecnol\303\263gico de Log\303\255stica Rodovi\303\241ria */}\n      <div className=\"absolute inset-0 pointer-events-none select-none overflow-hidden\">\n        {/* Gradiente de ilumina\303\247\303\243o fria e profundidade */}\n        <div className=\"absolute inset-0 bg-gradient-to-b from-[#070D18]/90 via-[#0B172A]/85 to-[#070D18]\"></div>\n        \n        {/* Luzes neon de frio e telemetria */}\n        <div className=\"absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-gradient-to-r from-blue-600/10 via-cyan-500/15 to-blue-500/10 rounded-full blur-3xl\"></div>\n        <div className=\"absolute -bottom-20 right-10 w-96 h-96 bg-cyan-600/10 rounded-full blur-3xl\"></div>\n        <div className=\"absolute -top-10 -left-10 w-80 h-80 bg-blue-700/10 rounded-full blur-3xl\"></div>\n\n        {/* Grade isom\303\251trica / malha de dados de transporte */}\n        <div \n          className=\"absolute inset-0 opacity-[0.04]\"\n          style={{\n            backgroundImage: `linear-gradient(to right, #38bdf8 1px, transparent 1px), linear-gradient(to bottom, #38bdf8 1px, transparent 1px)`,\n            backgroundSize: \'48px 48px\',\n          }}\n        ></div>\n\n        {/* Silhueta de Rodovia Tecnol\303\263gica com Feixes de Luz e Caminh\303\265es */}\n        <svg\n          viewBox=\"0 0 1440 600\"\n          className=\"absolute bottom-0 w-full h-[320px] md:h-[420px] object-cover opacity-25\"\n          preserveAspectRatio=\"none\"\n          fill=\"none\"\n        >\n          {/* Linha do horizonte */}\n          <path d=\"M0 450 L1440 450\" stroke=\"#1E293B\" strokeWidth=\"1\" />\n          \n          {/* Rodovia em perspectiva */}\n          <polygon points=\"720,280 480,600 960,600\" fill=\"#0A1322\" opacity=\"0.8\" />\n          <line x1=\"720\" y1=\"280\" x2=\"720\" y2=\"600\" stroke=\"#00F0FF\" strokeWidth=\"2\" strokeDasharray=\"16 16\" opacity=\"0.6\" />\n          <line x1=\"720\" y1=\"280\" x2=\"520\" y2=\"600\" stroke=\"#1E40AF\" strokeWidth=\"1.5\" opacity=\"0.5\" />\n          <line x1=\"720\" y1=\"280\" x2=\"920\" y2=\"600\" stroke=\"#1E40AF\" strokeWidth=\"1.5\" opacity=\"0.5\" />\n\n          {/* Feixes de telemetria / ondas de r\303\241dio */}\n          <path d=\"M 680 340 Q 720 310 760 340\" stroke=\"#00C2FF\" strokeWidth=\"2\" opacity=\"0.4\" fill=\"none\" />\n          <path d=\"M 650 360 Q 720 320 790 360\" stroke=\"#00C2FF\" strokeWidth=\"1.5\" opacity=\"0.3\" fill=\"none\" />\n          <path d=\"M 610 390 Q 720 330 830 390\" stroke=\"#00C2FF\" strokeWidth=\"1\" opacity=\"0.2\" fill=\"none\" />\n\n          {/* Silhuetas de carretas na estrada */}\n          <g transform=\"translate(685, 340) scale(0.45)\" fill=\"#1E293B\" stroke=\"#00F0FF\" strokeWidth=\"1.5\">\n            <rect x=\"0\" y=\"0\" width=\"80\" height=\"50\" rx=\"3\" fill=\"#0F172A\" />\n            <path d=\"M80 15 L95 15 L102 30 L102 50 L80 50 Z\" fill=\"#0F172A\" />\n            <circle cx=\"20\" cy=\"50\" r=\"8\" fill=\"#334155\" />\n            <circle cx=\"85\" cy=\"50\" r=\"8\" fill=\"#334155\" />\n            {/* Luz de freio vermelha e farol neon */}\n            <circle cx=\"5\" cy=\"40\" r=\"3\" fill=\"#EF4444\" />\n            <circle cx=\"100\" cy=\"40\" r=\"3\" fill=\"#00F0FF\" />\n          </g>\n        </svg>\n      </div>\n\n      <div className=\"relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center\">\n        \n        {/* Tag de Confian\303\247a / Badging de Mercado */}\n        <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-950/70 border border-cyan-500/30 text-cyan-300 text-xs font-semibold uppercase tracking-wider backdrop-blur-md shadow-xs mb-6 animate-fade-in\">\n          <span className=\"w-2 h-2 rounded-full bg-cyan-400 animate-pulse\"></span>\n          <span>Plataforma IoT de Seguran\303\247a Alimentar B2B</span>\n        </div>\n\n        {/* T\303\215TULO DE IMPACTO EXATO */}\n        <h1 \n          id=\"hero-title\"\n          className=\"text-3xl sm:text-5xl md:text-6xl lg:text-[64px] font-extrabold text-white tracking-tight leading-[1.12] max-w-4xl\"\n        >\n          A Integridade da Cadeia do Frio{\' \'}\n          <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-blue-400\">\n            na Palma da M\303\243o.\n          </span>\n        </h1>\n\n        {/* SLOGAN (SUBT\303\215TULO) EXATO */}\n        <p \n          id=\"hero-subtitle\"\n          className=\"mt-6 text-lg sm:text-xl md:text-2xl text-slate-300 font-normal max-w-2xl leading-relaxed\"\n        >\n          Monitoramento IoT inteligente para o transporte de carnes.\n        </p>\n\n        {/* Proposta de Valor Concisa */}\n        <p className=\"mt-3 text-sm sm:text-base text-slate-400 max-w-xl\">\n          Telemetria de alta precis\303\243o em tempo real e intelig\303\252ncia preditiva contra quebras t\303\251rmicas e perdas por desidrata\303\247\303\243o h\303\255drica.\n        </p>\n\n        {/* BOT\303\225ES DE A\303\207\303\203O (CTA) EXATOS */}\n        <div className=\"mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto\">\n          {/* CTA Prim\303\241rio: \"Conhe\303\247a a Solu\303\247\303\243o\" */}\n          <button\n            type=\"button\"\n            id=\"btn-hero-solucao\"\n            onClick={onExploreSolution}\n            className=\"w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl text-sm font-bold uppercase tracking-wider text-slate-950 bg-gradient-to-r from-cyan-400 via-cyan-300 to-blue-400 hover:from-cyan-300 hover:to-blue-300 shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 transition-all duration-200 transform hover:-translate-y-0.5 active:translate-y-0 cursor-pointer\"\n          >\n            <span>Conhe\303\247a a Solu\303\247\303\243o</span>\n            <ArrowRight className=\"w-4 h-4 text-slate-950\" />\n          </button>\n\n          {/* CTA Secund\303\241rio: \"Ver Apresenta\303\247\303\243o\" */}\n          <button\n            type=\"button\"\n            id=\"btn-hero-apresentacao\"\n            onClick={onOpenPresentation}\n            className=\"w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl text-sm font-bold uppercase tracking-wider text-slate-200 bg-slate-900/80 hover:bg-slate-800/90 border border-slate-700/80 hover:border-cyan-400/50 hover:text-white transition-all duration-200 backdrop-blur-md cursor-pointer\"\n          >\n            <Play className=\"w-4 h-4 text-cyan-400 fill-cyan-400/30\" />\n            <span>Ver Apresenta\303\247\303\243o</span>\n          </button>\n        </div>\n\n        {/* Indicadores de Efici\303\252ncia T\303\251cnica da Solu\303\247\303\243o */}\n        <div className=\"mt-16 pt-8 border-t border-slate-800/80 w-full max-w-3xl grid grid-cols-2 md:grid-cols-4 gap-4 text-center\">\n          <div className=\"p-2\">\n            <div className=\"text-xl sm:text-2xl font-black text-cyan-400 font-mono\">0\302\260C a 4\302\260C</div>\n            <div className=\"text-xs text-slate-400 mt-0.5 font-medium\">Faixa Cr\303\255tica Segura</div>\n          </div>\n          <div className=\"p-2\">\n            <div className=\"text-xl sm:text-2xl font-black text-white font-mono\">15s</div>\n            <div className=\"text-xs text-slate-400 mt-0.5 font-medium\">Telemetria Cont\303\255nua</div>\n          </div>\n          <div className=\"p-2\">\n            <div className=\"text-xl sm:text-2xl font-black text-cyan-400 font-mono\">100%</div>\n            <div className=\"text-xs text-slate-400 mt-0.5 font-medium\">Conformidade MAPA</div>\n          </div>\n          <div className=\"p-2\">\n            <div className=\"text-xl sm:text-2xl font-black text-emerald-400 font-mono\">45 min</div>\n            <div className=\"text-xs text-slate-400 mt-0.5 font-medium\">Alerta Preventivo</div>\n          </div>\n        </div>\n\n        {/* Bot\303\243o de rolagem suave indicando o conte\303\272do abaixo */}\n        <button\n          type=\"button\"\n          onClick={onExploreSolution}\n          aria-label=\"Rolar para a se\303\247\303\243o Miss\303\243o\"\n          className=\"mt-8 text-slate-500 hover:text-cyan-400 transition-colors p-2 rounded-full\"\n        >\n          <ChevronDown className=\"w-5 h-5 animate-bounce\" />\n        </button>\n\n      </div>\n    </section>\n  );\n};\n"
    }
