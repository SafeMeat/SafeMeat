  file_change {
    absolute_path_uri: "file:///src/components/PainelTelemetria.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Truck, \n  AlertTriangle, \n  Thermometer, \n  Wifi, \n  BatteryCharging, \n  Radio, \n  ArrowRight,\n  ShieldCheck,\n  CheckCircle,\n  Activity,\n  MapPin,\n  Clock,\n  Gauge\n} from \'lucide-react\';\n\ninterface PainelTelemetriaProps {\n  onAbrirCalculadora: () => void;\n}\n\nexport const PainelTelemetria: React.FC<PainelTelemetriaProps> = ({ onAbrirCalculadora }) => {\n  const [caminhaoSelecionado, setCaminhaoSelecionado] = useState<string>(\'DEF-5678\');\n\n  // Dados de frota com telemetria ativa\n  const veiculos = [\n    {\n      placa: \'ABC-1234\',\n      motorista: \'Carlos Silva\',\n      cnh: \'CNH-E \342\200\242 8 anos\',\n      temperatura: \'1.8\302\260C\',\n      umidade: \'89%\',\n      statusTemp: \'normal\',\n      rota: \'SP \342\206\222 RJ\',\n      chegadaEstimada: \'~14h30\',\n      bateria: \'96%\',\n      sinal: \'-72 dBm (Forte)\',\n      estadoCarga: \'Resfriada (Cortes Bovinos)\',\n      alerta: null,\n      dispositivo: \'ColdTrack SN-0041\',\n    },\n    {\n      placa: \'DEF-5678\',\n      motorista: \'Marcos Oliveira\',\n      cnh: \'CNH-E \342\200\242 12 anos\',\n      temperatura: \'4.5\302\260C \342\206\221\',\n      umidade: \'74% \342\206\223\',\n      statusTemp: \'alerta-preditivo\',\n      rota: \'SP \342\206\222 BH\',\n      chegadaEstimada: \'~16h00\',\n      bateria: \'78%\',\n      sinal: \'-89 dBm (M\303\251dio)\',\n      estadoCarga: \'Resfriada (In Natura)\',\n      alerta: \'Alerta Preditivo: Oscila\303\247\303\243o t\303\251rmica e queda de UR (74%). Risco de desidrata\303\247\303\243o acelerada detectado em 35 min.\',\n      dispositivo: \'ColdTrack SN-0042\',\n    },\n    {\n      placa: \'GHI-9012\',\n      motorista: \'Roberto Fonseca\',\n      cnh: \'CNH-E \342\200\242 5 anos\',\n      temperatura: \'2.6\302\260C\',\n      umidade: \'92%\',\n      statusTemp: \'normal\',\n      rota: \'SP \342\206\222 CWB\',\n      chegadaEstimada: \'~18h45\',\n      bateria: \'100% (Veicular)\',\n      sinal: \'-68 dBm (Forte)\',\n      estadoCarga: \'Congelada (-18\302\260C)\',\n      alerta: null,\n      dispositivo: \'ColdTrack SN-0043\',\n    },\n  ];\n\n  const veiculoAtual = veiculos.find(v => v.placa === caminhaoSelecionado) || veiculos[1];\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Alerta Preditivo Ativo no Topo */}\n      {veiculoAtual.alerta && (\n        <div className=\"bg-amber-50 border-2 border-amber-300 rounded-xl p-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-xs\">\n          <div className=\"flex items-start gap-3\">\n            <div className=\"p-2 bg-amber-500 text-white rounded-lg mt-0.5 shrink-0\">\n              <AlertTriangle className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-xs font-bold uppercase tracking-wider text-amber-900 bg-amber-200/80 px-2 py-0.5 rounded\">\n                  Dispositivo Preditivo ColdTrack em A\303\247\303\243o\n                </span>\n                <span className=\"text-xs font-semibold text-slate-700\">\n                  Ve\303\255culo {veiculoAtual.placa} ({veiculoAtual.rota})\n                </span>\n              </div>\n              <p className=\"text-sm text-amber-950 font-medium mt-1\">\n                {veiculoAtual.alerta}\n              </p>\n              <p className=\"text-xs text-amber-800/80 mt-0.5\">\n                A interven\303\247\303\243o preditiva antes do ponto de quebra evita a perda de 12% da carga e 2% em quebra de \303\241gua.\n              </p>\n            </div>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onAbrirCalculadora}\n            className=\"px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold rounded-lg transition-colors flex items-center gap-1.5 shrink-0 shadow-xs\"\n          >\n            Calcular Economia Desta Carga\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n      )}\n\n      {/* Cards de KPIs em tempo real */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        <div className=\"bg-white rounded-xl border border-slate-200 p-5 shadow-xs relative overflow-hidden\">\n          <div className=\"text-xs font-bold uppercase tracking-wider text-slate-400\">Caminh\303\265es em Rota</div>\n          <div className=\"text-3xl font-extrabold text-slate-900 mt-1\">\n            3 <span className=\"text-sm font-normal text-slate-500\">ve\303\255culos ativos</span>\n          </div>\n          <div className=\"flex items-center gap-1.5 text-xs text-emerald-700 font-semibold mt-2\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500\"></span>\n            100% dos sensores conectados via LTE-M\n          </div>\n          <Truck className=\"w-16 h-16 text-slate-100 absolute -right-2 -bottom-2 pointer-events-none\" />\n        </div>\n\n        <div className=\"bg-white rounded-xl border border-slate-200 p-5 shadow-xs relative overflow-hidden\">\n          <div className=\"text-xs font-bold uppercase tracking-wider text-slate-400\">Alertas Preditivos Ativos</div>\n          <div className=\"text-3xl font-extrabold text-amber-600 mt-1\">\n            1 <span className=\"text-sm font-normal text-slate-500\">sob monitoramento</span>\n          </div>\n          <div className=\"flex items-center gap-1.5 text-xs text-amber-700 font-semibold mt-2\">\n            <span className=\"w-2 h-2 rounded-full bg-amber-500 animate-ping\"></span>\n            DEF-5678: desvio t\303\251rmico mitigado a tempo\n          </div>\n          <AlertTriangle className=\"w-16 h-16 text-amber-50 absolute -right-2 -bottom-2 pointer-events-none\" />\n        </div>\n\n        <div className=\"bg-white rounded-xl border border-slate-200 p-5 shadow-xs relative overflow-hidden\">\n          <div className=\"text-xs font-bold uppercase tracking-wider text-slate-400\">Temperatura M\303\251dia da Frota</div>\n          <div className=\"text-3xl font-extrabold text-slate-900 mt-1\">\n            2.9 <span className=\"text-sm font-normal text-slate-500\">\302\260C</span>\n          </div>\n          <div className=\"flex items-center gap-1.5 text-xs text-emerald-700 font-semibold mt-2\">\n            <CheckCircle className=\"w-3.5 h-3.5 text-emerald-600\" />\n            Faixa operacional segura (0\302\260C a 4\302\260C)\n          </div>\n          <Thermometer className=\"w-16 h-16 text-slate-100 absolute -right-2 -bottom-2 pointer-events-none\" />\n        </div>\n      </div>\n\n      {/* Tabela de Telemetria e Monitoramento da Cadeia do Frio */}\n      <div className=\"bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden\">\n        <div className=\"p-5 border-b border-slate-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2\">\n          <div>\n            <h3 className=\"text-base font-bold text-slate-900 flex items-center gap-2\">\n              <Activity className=\"w-5 h-5 text-blue-600\" />\n              Telemetria dos Ve\303\255culos com Sensores IoT\n            </h3>\n            <p className=\"text-xs text-slate-500 mt-0.5\">\n              Leituras cont\303\255nuas de temperatura de carca\303\247a e umidade relativa de ar a cada 15 segundos\n            </p>\n          </div>\n          <span className=\"inline-flex items-center gap-1.5 text-xs font-medium text-blue-700 bg-blue-50 px-2.5 py-1 rounded-md border border-blue-200\">\n            <Radio className=\"w-3 h-3 text-blue-600 animate-pulse\" />\n            Rede LTE-M Online\n          </span>\n        </div>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-slate-50/80 text-slate-500 font-bold border-b border-slate-100 uppercase tracking-wider text-[11px]\">\n              <tr>\n                <th className=\"py-3.5 px-4\">Placa & Dispositivo</th>\n                <th className=\"py-3.5 px-4\">Motorista</th>\n                <th className=\"py-3.5 px-4\">Temperatura</th>\n                <th className=\"py-3.5 px-4\">Umidade Relativa</th>\n                <th className=\"py-3.5 px-4\">Rota / Chegada</th>\n                <th className=\"py-3.5 px-4\">Bateria & Sinal</th>\n                <th className=\"py-3.5 px-4\">Diagn\303\263stico Preditivo</th>\n                <th className=\"py-3.5 px-4 text-right\">A\303\247\303\243o</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 text-slate-700\">\n              {veiculos.map((v) => {\n                const isAlerta = v.statusTemp === \'alerta-preditivo\';\n                return (\n                  <tr \n                    key={v.placa} \n                    className={`hover:bg-slate-50/80 transition-colors ${\n                      isAlerta ? \'bg-amber-50/50\' : \'\'\n                    }`}\n                  >\n                    <td className=\"py-3.5 px-4\">\n                      <div className=\"font-mono font-bold text-slate-900 text-sm\">{v.placa}</div>\n                      <div className=\"text-[11px] text-slate-400\">{v.dispositivo}</div>\n                    </td>\n                    <td className=\"py-3.5 px-4\">\n                      <div className=\"font-semibold text-slate-900\">{v.motorista}</div>\n                      <div className=\"text-[11px] text-slate-400\">{v.cnh}</div>\n                    </td>\n                    <td className=\"py-3.5 px-4\">\n                      <span className={`font-bold text-sm ${isAlerta ? \'text-amber-700 font-extrabold\' : \'text-emerald-700\'}`}>\n                        {v.temperatura}\n                      </span>\n                    </td>\n                    <td className=\"py-3.5 px-4\">\n                      <span className={`font-semibold ${isAlerta ? \'text-amber-700\' : \'text-blue-700\'}`}>\n                        {v.umidade}\n                      </span>\n                    </td>\n                    <td className=\"py-3.5 px-4\">\n                      <div className=\"font-semibold text-slate-800\">{v.rota}</div>\n                      <div className=\"text-[11px] text-slate-400\">{v.chegadaEstimada}</div>\n                    </td>\n                    <td className=\"py-3.5 px-4\">\n                      <div className=\"flex items-center gap-1.5 text-slate-600\">\n                        <BatteryCharging className=\"w-3.5 h-3.5 text-emerald-600\" />\n                        <span>{v.bateria}</span>\n                      </div>\n                      <div className=\"text-[10px] text-slate-400\">{v.sinal}</div>\n                    </td>\n                    <td className=\"py-3.5 px-4\">\n                      {isAlerta ? (\n                        <span className=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-300\">\n                          <AlertTriangle className=\"w-3 h-3\" />\n                          Alerta Preditivo\n                        </span>\n                      ) : (\n                        <span className=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200\">\n                          <CheckCircle className=\"w-3 h-3\" />\n                          Normal\n                        </span>\n                      )}\n                    </td>\n                    <td className=\"py-3.5 px-4 text-right\">\n                      <button\n                        type=\"button\"\n                        onClick={() => {\n                          setCaminhaoSelecionado(v.placa);\n                          onAbrirCalculadora();\n                        }}\n                        className=\"px-2.5 py-1.5 rounded bg-blue-50 text-blue-700 hover:bg-blue-100 text-xs font-semibold transition\"\n                      >\n                        Simular Perdas\n                      </button>\n                    </td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
