  file_change {
    absolute_path_uri: "file:///src/components/TermsPrivacyModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { X, Shield, FileText } from \'lucide-react\';\n\ninterface TermsPrivacyModalProps {\n  type: \'terms\' | \'privacy\' | null;\n  onClose: () => void;\n}\n\nexport const TermsPrivacyModal: React.FC<TermsPrivacyModalProps> = ({ type, onClose }) => {\n  if (!type) return null;\n\n  const isPrivacy = type === \'privacy\';\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-xs animate-fade-in\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n    >\n      <div className=\"relative w-full max-w-xl bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden text-slate-900\">\n        \n        <div className=\"bg-[#070D18] text-white p-5 flex items-center justify-between border-b border-slate-800\">\n          <div className=\"flex items-center gap-2\">\n            {isPrivacy ? (\n              <Shield className=\"w-5 h-5 text-cyan-400\" />\n            ) : (\n              <FileText className=\"w-5 h-5 text-cyan-400\" />\n            )}\n            <h3 className=\"text-base font-bold text-white\">\n              {isPrivacy ? \'Pol\303\255tica de Privacidade\' : \'Termos de Uso do Servi\303\247o\'}\n            </h3>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        <div className=\"p-6 text-xs text-slate-600 space-y-3 leading-relaxed max-h-[60vh] overflow-y-auto\">\n          {isPrivacy ? (\n            <>\n              <p>\n                <strong>1. Compromisso com a Seguran\303\247a dos Dados:</strong> A Safe Meat respeita a privacidade de nossos parceiros e aplica as melhores pr\303\241ticas de prote\303\247\303\243o de dados (LGPD) para informa\303\247\303\265es operacionais de rotas, frotas e telemetria de cargas frigorificadas.\n              </p>\n              <p>\n                <strong>2. Coleta de Telemetria:</strong> As medi\303\247\303\265es captadas por nossos sensores IoT (temperatura, umidade relativa, geolocaliza\303\247\303\243o e status de energia do ba\303\272) pertencem exclusivamente ao contratante e s\303\243o armazenadas com criptografia de ponta a ponta.\n              </p>\n              <p>\n                <strong>3. Uso Restrito:</strong> Informa\303\247\303\265es de rota e conformidade t\303\251rmica jamais ser\303\243o comercializadas ou compartilhadas com terceiros sem anu\303\252ncia formal.\n              </p>\n              <p>\n                <strong>4. Contato do Encarregado (DPO):</strong> Para d\303\272vidas ou solicita\303\247\303\265es sobre seus dados, entre em contato via <span className=\"text-cyan-600 font-mono\">contato@safemeat.com.br</span>.\n              </p>\n            </>\n          ) : (\n            <>\n              <p>\n                <strong>1. Aceite dos Termos:</strong> Ao utilizar a plataforma Safe Meat e nossos dispositivos IoT de monitoramento preditivo, o usu\303\241rio declara concordar com os presentes termos de uso e condi\303\247\303\265es contratuais.\n              </p>\n              <p>\n                <strong>2. Prop\303\263sito da Solu\303\247\303\243o:</strong> A Safe Meat fornece tecnologia de telemetria preditiva e intelig\303\252ncia de dados para suporte preventivo \303\240 gest\303\243o da cadeia do frio. A conserva\303\247\303\243o da carga depende tamb\303\251m da correta manuten\303\247\303\243o mec\303\242nica dos ve\303\255culos e equipamentos de refrigera\303\247\303\243o.\n              </p>\n              <p>\n                <strong>3. Auditoria e Rastreabilidade:</strong> Nossos relat\303\263rios constituem hist\303\263rico digital fidedigno gerado por hardware calibrado, servindo para compliance interno e comprova\303\247\303\243o perante \303\263rg\303\243os regulat\303\263rios.\n              </p>\n            </>\n          )}\n        </div>\n\n        <div className=\"p-4 bg-slate-50 border-t border-slate-200 text-right\">\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"px-4 py-2 rounded-lg bg-slate-900 text-white text-xs font-bold uppercase tracking-wider hover:bg-slate-800 transition-colors\"\n          >\n            Entendido\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    }
