  file_change {
    absolute_path_uri: "file:///src/components/WhatWeDoSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Cpu, LayoutDashboard, Database, Radio, BellRing, ShieldCheck, Check, ArrowRight } from \'lucide-react\';\n\ninterface WhatWeDoSectionProps {\n  onOpenCalculator?: () => void;\n  onOpenSpecialist?: () => void;\n}\n\nexport const WhatWeDoSection: React.FC<WhatWeDoSectionProps> = ({\n  onOpenCalculator,\n  onOpenSpecialist,\n}) => {\n  return (\n    <section\n      id=\"solucao\"\n      className=\"py-24 md:py-32 bg-slate-50/70 border-t border-b border-slate-200/70 relative\"\n      aria-label=\"O Que Fazemos\"\n    >\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        {/* Cabe\303\247alho da Se\303\247\303\243o */}\n        <div className=\"text-center max-w-3xl mx-auto mb-16\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-semibold uppercase tracking-wider mb-4\">\n            <Cpu className=\"w-3.5 h-3.5 text-blue-700\" />\n            <span>Engenharia de Solu\303\247\303\265es</span>\n          </div>\n          \n          <h2 className=\"text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight\">\n            O Que Fazemos\n          </h2>\n          \n          <p className=\"mt-4 text-base sm:text-lg text-slate-600 leading-relaxed\">\n            Tecnologia de hardware dedicada e plataforma em nuvem para monitorar par\303\242metros higrot\303\251rmicos cr\303\255ticos no transporte frigorificado de carnes.\n          </p>\n        </div>\n\n        {/* LAYOUT COM 3 CARDS MINIMALISTAS EXATOS */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch\">\n          \n          {/* CARD 1 (\303\215cone de Sensor) */}\n          <div \n            id=\"card-funcionalidade-1\"\n            className=\"group bg-white rounded-2xl p-8 border border-slate-200/90 shadow-xs hover:shadow-xl hover:border-cyan-400/50 transition-all duration-300 flex flex-col justify-between relative overflow-hidden\"\n          >\n            {/* Indicador de status no topo */}\n            <div className=\"flex items-center justify-between mb-6\">\n              <div className=\"w-14 h-14 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300 shadow-xs\">\n                {/* \303\215cone de Sensor Corporativo */}\n                <Cpu className=\"w-7 h-7\" />\n              </div>\n              <span className=\"text-[11px] font-bold font-mono text-cyan-600 bg-cyan-50 px-2.5 py-1 rounded-full border border-cyan-200\">\n                LTE-M + BLE\n              </span>\n            </div>\n\n            <div>\n              <h3 className=\"text-xl font-bold text-slate-900 tracking-tight mb-3\">\n                Monitoramento IoT Cont\303\255nuo\n              </h3>\n              \n              <p className=\"text-slate-600 text-sm leading-relaxed mb-6\">\n                Sensores de precis\303\243o na cabine e no ba\303\272 medindo temperatura (0\302\260C a 4\302\260C) em tempo real.\n              </p>\n\n              <ul className=\"space-y-2.5 text-xs text-slate-600 border-t border-slate-100 pt-5\">\n                <li className=\"flex items-center gap-2\">\n                  <Check className=\"w-4 h-4 text-cyan-600 shrink-0\" />\n                  <span>Calibra\303\247\303\243o espec\303\255fica para prote\303\255na animal</span>\n                </li>\n                <li className=\"flex items-center gap-2\">\n                  <Check className=\"w-4 h-4 text-cyan-600 shrink-0\" />\n                  <span>Precis\303\243o microm\303\251trica de \302\2610.1\302\260C</span>\n                </li>\n                <li className=\"flex items-center gap-2\">\n                  <Check className=\"w-4 h-4 text-cyan-600 shrink-0\" />\n                  <span>Bateria aut\303\264noma de longa dura\303\247\303\243o (at\303\251 7 dias)</span>\n                </li>\n              </ul>\n            </div>\n\n            <div className=\"mt-8 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500 font-medium\">\n              <span>Hardware de Ba\303\272 Frigor\303\255fico</span>\n              <span className=\"text-blue-600 font-bold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1\">\n                Conectar &rarr;\n              </span>\n            </div>\n          </div>\n\n          {/* CARD 2 (\303\215cone de Alerta/Dashboard) */}\n          <div \n            id=\"card-funcionalidade-2\"\n            className=\"group bg-white rounded-2xl p-8 border border-slate-200/90 shadow-xs hover:shadow-xl hover:border-cyan-400/50 transition-all duration-300 flex flex-col justify-between relative overflow-hidden\"\n          >\n            {/* Indicador de status no topo */}\n            <div className=\"flex items-center justify-between mb-6\">\n              <div className=\"w-14 h-14 rounded-xl bg-cyan-50 text-cyan-700 flex items-center justify-center group-hover:bg-cyan-600 group-hover:text-white transition-colors duration-300 shadow-xs\">\n                {/* \303\215cone de Alerta / Dashboard */}\n                <LayoutDashboard className=\"w-7 h-7\" />\n              </div>\n              <span className=\"text-[11px] font-bold font-mono text-amber-600 bg-amber-50 px-2.5 py-1 rounded-full border border-amber-200 flex items-center gap-1\">\n                <BellRing className=\"w-3 h-3\" />\n                Alertas Preditivos\n              </span>\n            </div>\n\n            <div>\n              <h3 className=\"text-xl font-bold text-slate-900 tracking-tight mb-3\">\n                Dashboard de Controle\n              </h3>\n              \n              <p className=\"text-slate-600 text-sm leading-relaxed mb-6\">\n                Visibilidade total da carga e alertas preditivos para evitar perdas antes que aconte\303\247am.\n              </p>\n\n              <ul className=\"space-y-2.5 text-xs text-slate-600 border-t border-slate-100 pt-5\">\n                <li className=\"flex items-center gap-2\">\n                  <Check className=\"w-4 h-4 text-cyan-600 shrink-0\" />\n                  <span>Notifica\303\247\303\243o preventiva 45 min antes do ponto de quebra</span>\n                </li>\n                <li className=\"flex items-center gap-2\">\n                  <Check className=\"w-4 h-4 text-cyan-600 shrink-0\" />\n                  <span>Telemetria em mapa com geolocaliza\303\247\303\243o e rotas</span>\n                </li>\n                <li className=\"flex items-center gap-2\">\n                  <Check className=\"w-4 h-4 text-cyan-600 shrink-0\" />\n                  <span>Monitoramento t\303\251rmico e h\303\255drico unificado</span>\n                </li>\n              </ul>\n            </div>\n\n            <div className=\"mt-8 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500 font-medium\">\n              <span>Gest\303\243o de Frota Web/Mobile</span>\n              <span className=\"text-blue-600 font-bold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1\">\n                Visualizar &rarr;\n              </span>\n            </div>\n          </div>\n\n          {/* CARD 3 (\303\215cone de Banco de Dados/Nuvem) */}\n          <div \n            id=\"card-funcionalidade-3\"\n            className=\"group bg-white rounded-2xl p-8 border border-slate-200/90 shadow-xs hover:shadow-xl hover:border-cyan-400/50 transition-all duration-300 flex flex-col justify-between relative overflow-hidden\"\n          >\n            {/* Indicador de status no topo */}\n            <div className=\"flex items-center justify-between mb-6\">\n              <div className=\"w-14 h-14 rounded-xl bg-slate-100 text-slate-800 flex items-center justify-center group-hover:bg-slate-900 group-hover:text-white transition-colors duration-300 shadow-xs\">\n                {/* \303\215cone de Banco de Dados / Nuvem */}\n                <Database className=\"w-7 h-7\" />\n              </div>\n              <span className=\"text-[11px] font-bold font-mono text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200 flex items-center gap-1\">\n                <ShieldCheck className=\"w-3 h-3\" />\n                Auditoria 100%\n              </span>\n            </div>\n\n            <div>\n              <h3 className=\"text-xl font-bold text-slate-900 tracking-tight mb-3\">\n                Armazenamento e Compliance\n              </h3>\n              \n              <p className=\"text-slate-600 text-sm leading-relaxed mb-6\">\n                Reten\303\247\303\243o segura de dados via Edge Computing para auditorias rigorosas e rastreabilidade total.\n              </p>\n\n              <ul className=\"space-y-2.5 text-xs text-slate-600 border-t border-slate-100 pt-5\">\n                <li className=\"flex items-center gap-2\">\n                  <Check className=\"w-4 h-4 text-cyan-600 shrink-0\" />\n                  <span>Mem\303\263ria interna mesmo em \303\241reas sem sinal de operadora</span>\n                </li>\n                <li className=\"flex items-center gap-2\">\n                  <Check className=\"w-4 h-4 text-cyan-600 shrink-0\" />\n                  <span>Laudos autom\303\241ticos para fiscaliza\303\247\303\243o do MAPA e SIF</span>\n                </li>\n                <li className=\"flex items-center gap-2\">\n                  <Check className=\"w-4 h-4 text-cyan-600 shrink-0\" />\n                  <span>Trilha de auditoria criptografada e imut\303\241vel</span>\n                </li>\n              </ul>\n            </div>\n\n            <div className=\"mt-8 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500 font-medium\">\n              <span>Edge Computing Resiliente</span>\n              <span className=\"text-blue-600 font-bold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1\">\n                Auditar &rarr;\n              </span>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Faixa Complementar: Acesso r\303\241pido \303\240 Simula\303\247\303\243o Financeira de Perdas */}\n        {onOpenCalculator && (\n          <div className=\"mt-14 bg-gradient-to-r from-blue-900 via-slate-900 to-slate-950 rounded-2xl p-6 sm:p-8 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-lg\">\n            <div>\n              <div className=\"inline-flex items-center gap-2 text-xs font-bold text-cyan-400 uppercase tracking-wider mb-2\">\n                <span>Calculadora de Mitiga\303\247\303\243o Financeira Integrada</span>\n              </div>\n              <h4 className=\"text-xl sm:text-2xl font-bold text-white\">\n                Deseja simular o valor exato que sua opera\303\247\303\243o economizar\303\241?\n              </h4>\n              <p className=\"text-sm text-slate-300 mt-1 max-w-2xl\">\n                Nossa ferramenta calcula instantaneamente o desperd\303\255cio evitado pela redu\303\247\303\243o da quebra t\303\251rmica de 12% e da desidrata\303\247\303\243o h\303\255drica de 2% no frete.\n              </p>\n            </div>\n            \n            <button\n              type=\"button\"\n              onClick={onOpenCalculator}\n              className=\"px-6 py-3.5 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-xs uppercase tracking-wider transition-all duration-200 shrink-0 shadow-md flex items-center gap-2\"\n            >\n              <span>Simular Minha Carga</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </button>\n          </div>\n        )}\n\n      </div>\n    </section>\n  );\n};\n"
    }
