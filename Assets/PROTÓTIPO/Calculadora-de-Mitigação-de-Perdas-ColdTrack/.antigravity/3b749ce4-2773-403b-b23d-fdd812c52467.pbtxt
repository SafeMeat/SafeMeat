  file_change {
    absolute_path_uri: "file:///src/components/SpecialistModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { X, Send, CheckCircle2, MessageSquare, ShieldCheck, PhoneCall, Building } from \'lucide-react\';\n\ninterface SpecialistModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const SpecialistModal: React.FC<SpecialistModalProps> = ({ isOpen, onClose }) => {\n  const [formData, setFormData] = useState({\n    nome: \'\',\n    email: \'\',\n    empresa: \'\',\n    telefone: \'\',\n    tipoOperacao: \'Frigor\303\255fico / Ind\303\272stria\',\n    tamanhoFrota: \'1 a 10 caminh\303\265es\',\n    mensagem: \'\',\n  });\n\n  const [submitted, setSubmitted] = useState(false);\n\n  if (!isOpen) return null;\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setSubmitted(true);\n  };\n\n  const handleReset = () => {\n    setSubmitted(false);\n    onClose();\n  };\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-xs animate-fade-in\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"modal-specialist-title\"\n    >\n      <div className=\"relative w-full max-w-xl bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden text-slate-900 animate-scale-in\">\n        \n        {/* Barra superior */}\n        <div className=\"bg-gradient-to-r from-[#070D18] via-[#0B172A] to-[#0F2342] text-white p-6 relative\">\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"absolute top-5 right-5 p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors\"\n            aria-label=\"Fechar modal\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n\n          <div className=\"inline-flex items-center gap-1.5 text-xs font-semibold text-cyan-400 tracking-wider uppercase mb-1\">\n            <MessageSquare className=\"w-3.5 h-3.5\" />\n            <span>Consultoria T\303\251cnica B2B</span>\n          </div>\n\n          <h3 id=\"modal-specialist-title\" className=\"text-xl font-bold text-white\">\n            Fale com um Especialista Safe Meat\n          </h3>\n          <p className=\"text-xs text-slate-300 mt-1\">\n            Descubra como nossa telemetria IoT elimina perdas t\303\251rmicas na sua opera\303\247\303\243o de transporte frigor\303\255fico.\n          </p>\n        </div>\n\n        <div className=\"p-6 sm:p-8\">\n          {submitted ? (\n            <div className=\"text-center py-6\">\n              <div className=\"w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-4\">\n                <CheckCircle2 className=\"w-9 h-9\" />\n              </div>\n              <h4 className=\"text-xl font-bold text-slate-900 mb-2\">\n                Solicita\303\247\303\243o Recebida com Sucesso!\n              </h4>\n              <p className=\"text-sm text-slate-600 max-w-md mx-auto leading-relaxed mb-6\">\n                Obrigado pelo contato, <strong>{formData.nome || \'Parceiro\'}</strong>. Nossa equipe de engenharia e consultoria log\303\255stica entrar\303\241 em contato com voc\303\252 pelo e-mail <strong>{formData.email}</strong> em at\303\251 2 horas \303\272teis.\n              </p>\n              <div className=\"p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-600 max-w-sm mx-auto mb-6 text-left space-y-1\">\n                <div><strong>Empresa:</strong> {formData.empresa || \'N\303\243o informada\'}</div>\n                <div><strong>Opera\303\247\303\243o:</strong> {formData.tipoOperacao}</div>\n                <div><strong>Frota estimada:</strong> {formData.tamanhoFrota}</div>\n              </div>\n              <button\n                type=\"button\"\n                onClick={handleReset}\n                className=\"px-6 py-2.5 rounded-xl bg-blue-900 hover:bg-blue-800 text-white text-xs font-bold uppercase tracking-wider transition-colors\"\n              >\n                Concluir\n              </button>\n            </div>\n          ) : (\n            <form onSubmit={handleSubmit} className=\"space-y-4\">\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                    Nome Completo *\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={formData.nome}\n                    onChange={(e) => setFormData({ ...formData, nome: e.target.value })}\n                    placeholder=\"Ex: Carlos Eduardo\"\n                    className=\"w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                    E-mail Corporativo *\n                  </label>\n                  <input\n                    type=\"email\"\n                    required\n                    value={formData.email}\n                    onChange={(e) => setFormData({ ...formData, email: e.target.value })}\n                    placeholder=\"nome@empresa.com.br\"\n                    className=\"w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                    Nome da Empresa *\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={formData.empresa}\n                    onChange={(e) => setFormData({ ...formData, empresa: e.target.value })}\n                    placeholder=\"Ex: Frigor\303\255fico Vale do Frio\"\n                    className=\"w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                    Telefone / WhatsApp\n                  </label>\n                  <input\n                    type=\"tel\"\n                    value={formData.telefone}\n                    onChange={(e) => setFormData({ ...formData, telefone: e.target.value })}\n                    placeholder=\"(11) 99999-9999\"\n                    className=\"w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                    Perfil da Empresa\n                  </label>\n                  <select\n                    value={formData.tipoOperacao}\n                    onChange={(e) => setFormData({ ...formData, tipoOperacao: e.target.value })}\n                    className=\"w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 bg-white\"\n                  >\n                    <option value=\"Frigor\303\255fico / Ind\303\272stria\">Frigor\303\255fico / Ind\303\272stria</option>\n                    <option value=\"Transportadora Frigor\303\255fica\">Transportadora Frigor\303\255fica</option>\n                    <option value=\"Operador Log\303\255stico 3PL\">Operador Log\303\255stico 3PL</option>\n                    <option value=\"Rede Varejista / Supermercado\">Rede Varejista / Supermercado</option>\n                    <option value=\"Outro\">Outro</option>\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                    Volume da Frota\n                  </label>\n                  <select\n                    value={formData.tamanhoFrota}\n                    onChange={(e) => setFormData({ ...formData, tamanhoFrota: e.target.value })}\n                    className=\"w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 bg-white\"\n                  >\n                    <option value=\"1 a 10 caminh\303\265es\">1 a 10 caminh\303\265es</option>\n                    <option value=\"11 a 50 caminh\303\265es\">11 a 50 caminh\303\265es</option>\n                    <option value=\"Mais de 50 caminh\303\265es\">Mais de 50 caminh\303\265es</option>\n                    <option value=\"Rotas terceirizadas\">Rotas terceirizadas</option>\n                  </select>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                  Mensagem ou Necessidade Espec\303\255fica (Opcional)\n                </label>\n                <textarea\n                  rows={2}\n                  value={formData.mensagem}\n                  onChange={(e) => setFormData({ ...formData, mensagem: e.target.value })}\n                  placeholder=\"Conte-nos brevemente suas rotas ou desafios atuais de quebra de temperatura...\"\n                  className=\"w-full px-3.5 py-2 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500\"\n                ></textarea>\n              </div>\n\n              <div className=\"pt-2 flex items-center justify-between gap-4\">\n                <div className=\"flex items-center gap-1.5 text-[11px] text-slate-500\">\n                  <ShieldCheck className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n                  <span>Seus dados s\303\243o protegidos sob sigilo comercial.</span>\n                </div>\n\n                <button\n                  type=\"submit\"\n                  className=\"inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-xs uppercase tracking-wider transition-all shadow-md shadow-cyan-600/20 cursor-pointer\"\n                >\n                  <span>Enviar Solicita\303\247\303\243o</span>\n                  <Send className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </form>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
