    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Users, Code2, Cloud, Cpu, GraduationCap, Building2, CheckCircle2 } from \'lucide-react\';\n\nexport const AboutUsSection: React.FC = () => {\n  return (\n    <section\n      id=\"sobre-nos\"\n      className=\"py-24 md:py-32 bg-slate-100/80 text-slate-900 border-b border-slate-200\"\n      aria-label=\"Resumo R\303\241pido Sobre N\303\263s\"\n    >\n      <div className=\"max-w-5xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        {/* Cabe\303\247alho da Se\303\247\303\243o */}\n        <div className=\"text-center max-w-2xl mx-auto mb-12\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-200 text-slate-700 text-xs font-semibold uppercase tracking-wider mb-4\">\n            <Users className=\"w-3.5 h-3.5 text-blue-700\" />\n            <span>Quem Somos</span>\n          </div>\n          \n          <h2 className=\"text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight\">\n            Sobre N\303\263s\n          </h2>\n        </div>\n\n        {/* Card Principal com o Texto Exato */}\n        <div className=\"bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm relative overflow-hidden\">\n          \n          <div className=\"max-w-3xl mx-auto text-center\">\n            {/* \303\215cone sutil decorativo */}\n            <div className=\"w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-900 to-slate-900 text-cyan-400 mx-auto flex items-center justify-center mb-8 shadow-md\">\n              <GraduationCap className=\"w-8 h-8\" />\n            </div>\n\n            {/* TEXTO EXATO EXIGIDO */}\n            <p \n              id=\"about-us-text\"\n              className=\"text-lg sm:text-xl md:text-2xl text-slate-800 font-normal leading-relaxed\"\n            >\n              Somos uma equipe multidisciplinar de estudantes de An\303\241lise e Desenvolvimento de Sistemas. Focados em criar arquiteturas robustas de back-end, computa\303\247\303\243o em nuvem e solu\303\247\303\265es IoT, nascemos para resolver os gargalos reais do setor log\303\255stico com tecnologia de ponta, unindo aprendizado acad\303\252mico e vis\303\243o de mercado.\n            </p>\n          </div>\n\n          {/* Grid com as 4 compet\303\252ncias t\303\251cnicas fundamentais */}\n          <div className=\"mt-12 pt-10 border-t border-slate-100 grid grid-cols-2 md:grid-cols-4 gap-4\">\n            \n            <div className=\"p-4 rounded-xl bg-slate-50 border border-slate-100 flex flex-col items-center text-center\">\n              <Code2 className=\"w-6 h-6 text-blue-600 mb-2\" />\n              <span className=\"text-xs font-bold text-slate-900\">Back-end Resiliente</span>\n              <span className=\"text-[11px] text-slate-500 mt-0.5\">APIs cr\303\255ticas & telemetria</span>\n            </div>\n\n            <div className=\"p-4 rounded-xl bg-slate-50 border border-slate-100 flex flex-col items-center text-center\">\n              <Cloud className=\"w-6 h-6 text-cyan-600 mb-2\" />\n              <span className=\"text-xs font-bold text-slate-900\">Nuvem & Escalabilidade</span>\n              <span className=\"text-[11px] text-slate-500 mt-0.5\">Sistemas distribu\303\255dos</span>\n            </div>\n\n            <div className=\"p-4 rounded-xl bg-slate-50 border border-slate-100 flex flex-col items-center text-center\">\n              <Cpu className=\"w-6 h-6 text-indigo-600 mb-2\" />\n              <span className=\"text-xs font-bold text-slate-900\">Hardware & IoT</span>\n              <span className=\"text-[11px] text-slate-500 mt-0.5\">Sensores e telemetria Edge</span>\n            </div>\n\n            <div className=\"p-4 rounded-xl bg-slate-50 border border-slate-100 flex flex-col items-center text-center\">\n              <Building2 className=\"w-6 h-6 text-slate-800 mb-2\" />\n              <span className=\"text-xs font-bold text-slate-900\">Vis\303\243o de Mercado B2B</span>\n              <span className=\"text-[11px] text-slate-500 mt-0.5\">Log\303\255stica da cadeia fria</span>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
