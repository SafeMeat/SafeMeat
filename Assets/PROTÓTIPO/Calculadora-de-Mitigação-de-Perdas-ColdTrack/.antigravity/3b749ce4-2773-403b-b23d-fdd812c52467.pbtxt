  file_change {
    absolute_path_uri: "file:///src/components/Header.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { SafeMeatLogo } from \'./SafeMeatLogo\';\nimport { MessageSquare, Menu, X, ArrowUpRight, Calculator } from \'lucide-react\';\n\ninterface HeaderProps {\n  onOpenSpecialist: () => void;\n  onOpenCalculator?: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  onOpenSpecialist,\n  onOpenCalculator,\n}) => {\n  const [scrolled, setScrolled] = useState(false);\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      setScrolled(window.scrollY > 20);\n    };\n    window.addEventListener(\'scroll\', handleScroll, { passive: true });\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  const scrollToSection = (id: string) => {\n    setMobileMenuOpen(false);\n    const element = document.getElementById(id);\n    if (element) {\n      const yOffset = -72; // compensar header fixo\n      const y = element.getBoundingClientRect().top + window.pageYOffset + yOffset;\n      window.scrollTo({ top: y, behavior: \'smooth\' });\n    }\n  };\n\n  return (\n    <header\n      className={`fixed top-0 left-0 right-0 z-40 transition-all duration-300 ${\n        scrolled\n          ? \'bg-[#0B132B]/90 backdrop-blur-md border-b border-cyan-900/30 shadow-lg shadow-black/20 py-3\'\n          : \'bg-[#070D18]/70 backdrop-blur-xs border-b border-white/5 py-4\'\n      }`}\n    >\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between\">\n          \n          {/* Lado Esquerdo: Logo em texto \"Safe Meat\" com \303\255cone minimalista */}\n          <a\n            href=\"#\"\n            onClick={(e) => {\n              e.preventDefault();\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\n            }}\n            className=\"group flex items-center transition-opacity hover:opacity-95\"\n            aria-label=\"Safe Meat Home\"\n          >\n            <SafeMeatLogo variant=\"horizontal\" darkBg={true} />\n          </a>\n\n          {/* Lado Direito: Navega\303\247\303\243o simples (Solu\303\247\303\243o, Miss\303\243o, Sobre N\303\263s) + Bot\303\243o de destaque */}\n          <nav className=\"hidden md:flex items-center gap-8\">\n            <div className=\"flex items-center gap-7 text-sm font-medium text-slate-300\">\n              <button\n                type=\"button\"\n                onClick={() => scrollToSection(\'solucao\')}\n                className=\"hover:text-cyan-400 transition-colors cursor-pointer py-1\"\n              >\n                Solu\303\247\303\243o\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => scrollToSection(\'missao\')}\n                className=\"hover:text-cyan-400 transition-colors cursor-pointer py-1\"\n              >\n                Miss\303\243o\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => scrollToSection(\'sobre-nos\')}\n                className=\"hover:text-cyan-400 transition-colors cursor-pointer py-1\"\n              >\n                Sobre N\303\263s\n              </button>\n\n              {onOpenCalculator && (\n                <button\n                  type=\"button\"\n                  onClick={onOpenCalculator}\n                  className=\"flex items-center gap-1.5 text-xs text-slate-400 hover:text-cyan-300 transition-colors cursor-pointer px-2.5 py-1 rounded-md bg-slate-800/60 border border-slate-700/60\"\n                  title=\"Abrir Simulador Financeiro de Perdas\"\n                >\n                  <Calculator className=\"w-3.5 h-3.5 text-cyan-400\" />\n                  Simulador de ROI\n                </button>\n              )}\n            </div>\n\n            {/* Bot\303\243o de Destaque: \"Fale com um Especialista\" */}\n            <button\n              type=\"button\"\n              id=\"btn-header-especialista\"\n              onClick={onOpenSpecialist}\n              className=\"relative group inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider text-slate-900 bg-gradient-to-r from-cyan-400 via-cyan-300 to-blue-400 hover:from-cyan-300 hover:to-blue-300 shadow-md shadow-cyan-500/20 hover:shadow-cyan-500/35 transition-all duration-200 transform hover:-translate-y-0.5 active:translate-y-0 cursor-pointer\"\n            >\n              <MessageSquare className=\"w-3.5 h-3.5 text-slate-900\" />\n              <span>Fale com um Especialista</span>\n              <div className=\"absolute -inset-0.5 rounded-lg bg-cyan-400/40 blur-[3px] opacity-0 group-hover:opacity-100 transition-opacity -z-10\"></div>\n            </button>\n          </nav>\n\n          {/* Bot\303\243o Menu Mobile */}\n          <div className=\"md:hidden flex items-center gap-2\">\n            <button\n              type=\"button\"\n              onClick={onOpenSpecialist}\n              className=\"text-xs font-bold px-3 py-1.5 rounded-md bg-cyan-400 text-slate-950\"\n            >\n              Falar\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n              className=\"p-2 text-slate-300 hover:text-white rounded-lg bg-slate-800/80 border border-slate-700/50\"\n              aria-label=\"Abrir menu\"\n            >\n              {mobileMenuOpen ? <X className=\"w-5 h-5\" /> : <Menu className=\"w-5 h-5\" />}\n            </button>\n          </div>\n\n        </div>\n      </div>\n\n      {/* Menu Dropdown Mobile */}\n      {mobileMenuOpen && (\n        <div className=\"md:hidden bg-[#070D18]/95 border-b border-slate-800 px-4 pt-3 pb-5 space-y-3 backdrop-blur-lg\">\n          <button\n            type=\"button\"\n            onClick={() => scrollToSection(\'solucao\')}\n            className=\"block w-full text-left py-2 text-sm font-medium text-slate-200 hover:text-cyan-400\"\n          >\n            Solu\303\247\303\243o\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => scrollToSection(\'missao\')}\n            className=\"block w-full text-left py-2 text-sm font-medium text-slate-200 hover:text-cyan-400\"\n          >\n            Miss\303\243o\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => scrollToSection(\'sobre-nos\')}\n            className=\"block w-full text-left py-2 text-sm font-medium text-slate-200 hover:text-cyan-400\"\n          >\n            Sobre N\303\263s\n          </button>\n          {onOpenCalculator && (\n            <button\n              type=\"button\"\n              onClick={() => {\n                setMobileMenuOpen(false);\n                onOpenCalculator();\n              }}\n              className=\"flex items-center gap-2 w-full text-left py-2 text-sm font-medium text-cyan-400\"\n            >\n              <Calculator className=\"w-4 h-4\" />\n              Simulador de ROI de Perdas\n            </button>\n          )}\n          <div className=\"pt-2\">\n            <button\n              type=\"button\"\n              onClick={() => {\n                setMobileMenuOpen(false);\n                onOpenSpecialist();\n              }}\n              className=\"w-full py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider text-slate-900 bg-cyan-400 text-center\"\n            >\n              Fale com um Especialista\n            </button>\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
    }
