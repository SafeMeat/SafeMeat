    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ShieldCheck, TrendingDown, Award } from \'lucide-react\';\n\nexport const MissionSection: React.FC = () => {\n  return (\n    <section\n      id=\"missao\"\n      className=\"py-24 md:py-32 bg-white text-slate-900 relative overflow-hidden\"\n      aria-label=\"Nossa Miss\303\243o\"\n    >\n      <div className=\"max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center\">\n        \n        {/* Selo Minimalista Superior */}\n        <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-semibold uppercase tracking-wider mb-8\">\n          <ShieldCheck className=\"w-3.5 h-3.5 text-blue-600\" />\n          <span>Prop\303\263sito Institucional</span>\n        </div>\n\n        {/* TEXTO CENTRALIZADO EXATO EXIGIDO */}\n        <blockquote className=\"max-w-4xl mx-auto\">\n          <p \n            id=\"mission-text\"\n            className=\"text-2xl sm:text-3xl md:text-4xl font-semibold tracking-tight text-slate-900 leading-[1.35]\"\n          >\n            <span className=\"font-bold text-blue-900\">Nossa Miss\303\243o:</span>{\' \'}\n            Garantir a seguran\303\247a alimentar e mitigar os riscos financeiros do transporte log\303\255stico atrav\303\251s de telemetria ininterrupta e auditoria confi\303\241vel, blindando a reputa\303\247\303\243o das marcas produtoras.\n          </p>\n        </blockquote>\n\n        {/* Divisor Sutil */}\n        <div className=\"w-20 h-1 bg-gradient-to-r from-blue-600 to-cyan-400 mx-auto mt-10 mb-14 rounded-full\"></div>\n\n        {/* 3 Pilares Estruturais da Miss\303\243o */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8 text-left mt-8\">\n          \n          <div className=\"p-6 rounded-2xl bg-slate-50/80 border border-slate-100 transition-all hover:border-slate-200 hover:bg-slate-50\">\n            <div className=\"w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center mb-4\">\n              <ShieldCheck className=\"w-5 h-5\" />\n            </div>\n            <h3 className=\"text-base font-bold text-slate-900 mb-2\">\n              Seguran\303\247a Alimentar Rigorosa\n            </h3>\n            <p className=\"text-sm text-slate-600 leading-relaxed\">\n              Prote\303\247\303\243o microbiol\303\263gica da prote\303\255na animal da origem ao destino, assegurando que o consumidor receba produtos frescos e no padr\303\243o sanit\303\241rio m\303\241ximo.\n            </p>\n          </div>\n\n          <div className=\"p-6 rounded-2xl bg-slate-50/80 border border-slate-100 transition-all hover:border-slate-200 hover:bg-slate-50\">\n            <div className=\"w-10 h-10 rounded-xl bg-cyan-100 text-cyan-700 flex items-center justify-center mb-4\">\n              <TrendingDown className=\"w-5 h-5\" />\n            </div>\n            <h3 className=\"text-base font-bold text-slate-900 mb-2\">\n              Mitiga\303\247\303\243o de Perdas Financeiras\n            </h3>\n            <p className=\"text-sm text-slate-600 leading-relaxed\">\n              Elimina\303\247\303\243o do desperd\303\255cio invis\303\255vel com alertas preditivos que antecipam desvios de temperatura e desidrata\303\247\303\243o antes que ocorra a quebra de valor da carga.\n            </p>\n          </div>\n\n          <div className=\"p-6 rounded-2xl bg-slate-50/80 border border-slate-100 transition-all hover:border-slate-200 hover:bg-slate-50\">\n            <div className=\"w-10 h-10 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center mb-4\">\n              <Award className=\"w-5 h-5\" />\n            </div>\n            <h3 className=\"text-base font-bold text-slate-900 mb-2\">\n              Blindagem de Reputa\303\247\303\243o\n            </h3>\n            <p className=\"text-sm text-slate-600 leading-relaxed\">\n              Trilhas de auditoria criptografadas e dados imut\303\241veis que garantem compliance inquestion\303\241vel perante frigor\303\255ficos, transportadoras e varejistas.\n            </p>\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
