    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { SplashAnimation } from \'./components/SplashAnimation\';\nimport { Header } from \'./components/Header\';\nimport { HeroSection } from \'./components/HeroSection\';\nimport { MissionSection } from \'./components/MissionSection\';\nimport { WhatWeDoSection } from \'./components/WhatWeDoSection\';\nimport { AboutUsSection } from \'./components/AboutUsSection\';\nimport { Footer } from \'./components/Footer\';\nimport { SpecialistModal } from \'./components/SpecialistModal\';\nimport { PresentationModal } from \'./components/PresentationModal\';\nimport { TermsPrivacyModal } from \'./components/TermsPrivacyModal\';\nimport { CalculadoraModal } from \'./components/CalculadoraModal\';\n\nexport default function App() {\n  const [splashAtivo, setSplashAtivo] = useState(true);\n  const [modalEspecialistaAberto, setModalEspecialistaAberto] = useState(false);\n  const [modalApresentacaoAberto, setModalApresentacaoAberto] = useState(false);\n  const [modalTermosPrivacidade, setModalTermosPrivacidade] = useState<\'terms\' | \'privacy\' | null>(null);\n  const [modalCalculadoraAberto, setModalCalculadoraAberto] = useState(false);\n\n  const scrollToSection = (id: string) => {\n    const element = document.getElementById(id);\n    if (element) {\n      const yOffset = -72;\n      const y = element.getBoundingClientRect().top + window.pageYOffset + yOffset;\n      window.scrollTo({ top: y, behavior: \'smooth\' });\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-white text-slate-900 font-sans antialiased selection:bg-cyan-500 selection:text-white\">\n      \n      {/* 1. Anima\303\247\303\243o de Entrada (Efeito Splash r\303\241pido de 1.5s) */}\n      {splashAtivo && (\n        <SplashAnimation\n          duracaoMs={1500}\n          onComplete={() => setSplashAtivo(false)}\n        />\n      )}\n\n      {/* 2. Header (Fixo e Minimalista) */}\n      <Header\n        onOpenSpecialist={() => setModalEspecialistaAberto(true)}\n        onOpenCalculator={() => setModalCalculadoraAberto(true)}\n      />\n\n      {/* Conte\303\272do Principal com Efeito Fade-In Suave p\303\263s-splash */}\n      <main className=\"transition-opacity duration-700 ease-out\">\n        \n        {/* 3. Hero Section (Banner Principal) */}\n        <HeroSection\n          onExploreSolution={() => scrollToSection(\'solucao\')}\n          onOpenPresentation={() => setModalApresentacaoAberto(true)}\n        />\n\n        {/* 4. Nossa Miss\303\243o (Fundo Branco, Texto Centralizado) */}\n        <MissionSection />\n\n        {/* 5. O Que Fazemos (3 Cards Minimalistas com \303\215cones Corporativos) */}\n        <WhatWeDoSection\n          onOpenCalculator={() => setModalCalculadoraAberto(true)}\n          onOpenSpecialist={() => setModalEspecialistaAberto(true)}\n        />\n\n        {/* 6. Resumo R\303\241pido Sobre N\303\263s (Fundo Levemente Acinzentado) */}\n        <AboutUsSection />\n\n      </main>\n\n      {/* 7. Footer (Rodap\303\251 Simples e Escuro) */}\n      <Footer\n        onReplaySplash={() => setSplashAtivo(true)}\n        onOpenSpecialist={() => setModalEspecialistaAberto(true)}\n        onOpenPrivacy={() => setModalTermosPrivacidade(\'privacy\')}\n        onOpenTerms={() => setModalTermosPrivacidade(\'terms\')}\n      />\n\n      {/* Modais de Suporte e Intera\303\247\303\243o B2B */}\n      <SpecialistModal\n        isOpen={modalEspecialistaAberto}\n        onClose={() => setModalEspecialistaAberto(false)}\n      />\n\n      <PresentationModal\n        isOpen={modalApresentacaoAberto}\n        onClose={() => setModalApresentacaoAberto(false)}\n        onOpenCalculator={() => setModalCalculadoraAberto(true)}\n      />\n\n      <TermsPrivacyModal\n        type={modalTermosPrivacidade}\n        onClose={() => setModalTermosPrivacidade(null)}\n      />\n\n      <CalculadoraModal\n        isOpen={modalCalculadoraAberto}\n        onClose={() => setModalCalculadoraAberto(false)}\n      />\n\n    </div>\n  );\n}\n"
    }
