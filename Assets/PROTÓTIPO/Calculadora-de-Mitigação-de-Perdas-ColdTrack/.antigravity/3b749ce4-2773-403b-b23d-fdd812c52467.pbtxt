  file_change {
    absolute_path_uri: "file:///src/components/Footer.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { SafeMeatLogo } from \'./SafeMeatLogo\';\nimport { Mail, Linkedin, Shield, FileText, ArrowUp, RefreshCw } from \'lucide-react\';\n\ninterface FooterProps {\n  onReplaySplash?: () => void;\n  onOpenSpecialist?: () => void;\n  onOpenPrivacy?: () => void;\n  onOpenTerms?: () => void;\n}\n\nexport const Footer: React.FC<FooterProps> = ({\n  onReplaySplash,\n  onOpenSpecialist,\n  onOpenPrivacy,\n  onOpenTerms,\n}) => {\n  const scrollToTop = () => {\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <footer\n      className=\"bg-[#070D18] text-slate-400 border-t border-slate-800/80 pt-16 pb-12 select-none\"\n      aria-label=\"Rodap\303\251 Safe Meat\"\n    >\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-slate-800/80\">\n          \n          {/* Coluna 1: Logo Safe Meat & Slogan */}\n          <div className=\"md:col-span-2 space-y-4\">\n            <SafeMeatLogo variant=\"horizontal\" darkBg={true} />\n            <p className=\"text-sm text-slate-400 max-w-sm leading-relaxed\">\n              Tecnologia IoT de ponta para a cadeia do frio de carnes. Seguran\303\247a alimentar, integridade e mitiga\303\247\303\243o de perdas log\303\255sticas em cada quil\303\264metro.\n            </p>\n            <div className=\"pt-2 flex items-center gap-3\">\n              <a\n                href=\"mailto:contato@safemeat.com.br\"\n                className=\"inline-flex items-center gap-2 text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition-colors py-1 px-3 rounded-md bg-slate-900 border border-slate-800\"\n              >\n                <Mail className=\"w-3.5 h-3.5\" />\n                <span>contato@safemeat.com.br</span>\n              </a>\n              {onReplaySplash && (\n                <button\n                  type=\"button\"\n                  onClick={onReplaySplash}\n                  className=\"inline-flex items-center gap-1.5 text-xs text-slate-500 hover:text-slate-300 transition-colors py-1 px-2.5 rounded-md bg-slate-900 border border-slate-800/80 cursor-pointer\"\n                  title=\"Ver anima\303\247\303\243o de abertura novamente\"\n                >\n                  <RefreshCw className=\"w-3 h-3\" />\n                  <span>Replay Splash</span>\n                </button>\n              )}\n            </div>\n          </div>\n\n          {/* Coluna 2: Navega\303\247\303\243o R\303\241pida */}\n          <div className=\"space-y-3\">\n            <h4 className=\"text-xs font-bold text-slate-200 uppercase tracking-wider\">\n              Navega\303\247\303\243o\n            </h4>\n            <ul className=\"space-y-2 text-sm\">\n              <li>\n                <a\n                  href=\"#solucao\"\n                  className=\"hover:text-cyan-400 transition-colors\"\n                >\n                  Nossa Solu\303\247\303\243o\n                </a>\n              </li>\n              <li>\n                <a\n                  href=\"#missao\"\n                  className=\"hover:text-cyan-400 transition-colors\"\n                >\n                  Nossa Miss\303\243o\n                </a>\n              </li>\n              <li>\n                <a\n                  href=\"#sobre-nos\"\n                  className=\"hover:text-cyan-400 transition-colors\"\n                >\n                  Sobre N\303\263s\n                </a>\n              </li>\n              {onOpenSpecialist && (\n                <li>\n                  <button\n                    type=\"button\"\n                    onClick={onOpenSpecialist}\n                    className=\"hover:text-cyan-400 transition-colors text-left\"\n                  >\n                    Fale com um Especialista\n                  </button>\n                </li>\n              )}\n            </ul>\n          </div>\n\n          {/* Coluna 3: Links R\303\241pidos & Redes */}\n          <div className=\"space-y-3\">\n            <h4 className=\"text-xs font-bold text-slate-200 uppercase tracking-wider\">\n              Institucional\n            </h4>\n            <ul className=\"space-y-2 text-sm\">\n              <li>\n                <a\n                  href=\"https://www.linkedin.com\"\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"inline-flex items-center gap-2 hover:text-cyan-400 transition-colors\"\n                >\n                  <Linkedin className=\"w-4 h-4 text-[#0077B5]\" />\n                  <span>LinkedIn do Projeto</span>\n                </a>\n              </li>\n              <li>\n                <button\n                  type=\"button\"\n                  onClick={onOpenTerms}\n                  className=\"inline-flex items-center gap-2 hover:text-cyan-400 transition-colors text-left\"\n                >\n                  <FileText className=\"w-4 h-4 text-slate-500\" />\n                  <span>Termos de Uso</span>\n                </button>\n              </li>\n              <li>\n                <button\n                  type=\"button\"\n                  onClick={onOpenPrivacy}\n                  className=\"inline-flex items-center gap-2 hover:text-cyan-400 transition-colors text-left\"\n                >\n                  <Shield className=\"w-4 h-4 text-slate-500\" />\n                  <span>Pol\303\255tica de Privacidade</span>\n                </button>\n              </li>\n            </ul>\n          </div>\n\n        </div>\n\n        {/* Linha Inferior com o Copyright Exato */}\n        <div className=\"pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500\">\n          \n          {/* TEXTO EXATO EXIGIDO */}\n          <p id=\"copyright-text\" className=\"font-medium\">\n            \302\251 2026 Safe Meat. Todos os direitos reservados.\n          </p>\n\n          <div className=\"flex items-center gap-6\">\n            <span className=\"text-slate-600\">\n              Projeto Acad\303\252mico ADS \342\200\242 Tecnologia e Seguran\303\247a Alimentar\n            </span>\n\n            {/* Voltar ao Topo */}\n            <button\n              type=\"button\"\n              onClick={scrollToTop}\n              className=\"p-2 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-400 hover:text-cyan-400 border border-slate-800 transition-colors cursor-pointer\"\n              aria-label=\"Voltar ao in\303\255cio da p\303\241gina\"\n            >\n              <ArrowUp className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n        </div>\n\n      </div>\n    </footer>\n  );\n};\n"
    }
