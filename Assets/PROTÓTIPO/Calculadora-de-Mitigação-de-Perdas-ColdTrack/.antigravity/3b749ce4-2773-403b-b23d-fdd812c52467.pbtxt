    tool_summary: "Build loss mitigation calculator component"
    tool_action: "Create CalculadoraPerdas.tsx"
    started_at {
      seconds: 1788394235
      nanos: 77946829
    }
  }
  file_change {
    absolute_path_uri: "file:///src/components/CalculadoraPerdas.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useId } from \'react\';\nimport { \n  DollarSign, \n  Scale, \n  Snowflake, \n  Droplets, \n  TrendingUp, \n  AlertTriangle, \n  ShieldCheck, \n  CheckCircle2, \n  HelpCircle,\n  BarChart3,\n  Flame,\n  ThermometerSnowflake,\n  Sparkles,\n  Printer,\n  RotateCcw\n} from \'lucide-react\';\nimport { EstadoMercadoria, CalculoPerdasResponse } from \'../types\';\nimport { calcularMitigacaoPerdas, formatarMoedaBRL, formatarNumeroBR } from \'../lib/calculadoraEngine\';\n\ninterface CalculadoraPerdasProps {\n  onNotify?: (msg: string) => void;\n}\n\nexport const CalculadoraPerdas: React.FC<CalculadoraPerdasProps> = () => {\n  // Inputs obrigat\303\263rios solicitados\n  const [pesoTotalKg, setPesoTotalKg] = useState<number>(25000);\n  const [valorMedioKg, setValorMedioKg] = useState<number>(28.50);\n  const [estadoMercadoria, setEstadoMercadoria] = useState<EstadoMercadoria>(\'resfriada\');\n\n  // Inputs complementares para simula\303\247\303\243o de ROI completa\n  const [custoDispositivo, setCustoDispositivo] = useState<number>(2200);\n  const [viagensMes, setViagensMes] = useState<number>(14);\n\n  // Estado do resultado e status da API\n  const [resultado, setResultado] = useState<CalculoPerdasResponse>(() => \n    calcularMitigacaoPerdas({\n      pesoTotalKg: 25000,\n      valorMedioKg: 28.50,\n      estadoMercadoria: \'resfriada\',\n      custoDispositivo: 2200,\n      viagensMes: 14,\n    })\n  );\n  const [isCalculandoApi, setIsCalculandoApi] = useState<boolean>(false);\n  const [backendConectado, setBackendConectado] = useState<boolean>(true);\n  const [exibirInfoTecnica, setExibirInfoTecnica] = useState<boolean>(false);\n\n  const pesoInputId = useId();\n  const valorInputId = useId();\n  const custoInputId = useId();\n  const viagensInputId = useId();\n\n  // Executar chamada ao back-end (com fallback no motor local para reatividade instant\303\242nea)\n  const processarCalculo = async (\n    peso: number, \n    preco: number, \n    estado: EstadoMercadoria,\n    custo: number,\n    viagens: number\n  ) => {\n    // C\303\241lculo imediato para resposta t\303\241til de 0ms\n    const calculoLocal = calcularMitigacaoPerdas({\n      pesoTotalKg: peso,\n      valorMedioKg: preco,\n      estadoMercadoria: estado,\n      custoDispositivo: custo,\n      viagensMes: viagens,\n    });\n    setResultado(calculoLocal);\n\n    // Confirma\303\247\303\243o via API back-end em segundo plano\n    try {\n      setIsCalculandoApi(true);\n      const res = await fetch(\'/api/calculadora-perdas\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          pesoTotalKg: peso,\n          valorMedioKg: preco,\n          estadoMercadoria: estado,\n          custoDispositivo: custo,\n          viagensMes: viagens,\n        }),\n      });\n\n      if (res.ok) {\n        const json = await res.json();\n        if (json.sucesso && json.data) {\n          // Atualiza com dados oficiais validados pelo servidor\n          setResultado({\n            ...calculoLocal,\n            valorTotalCarga: json.data.valorTotalCarga,\n            perdaCadeiaFrio: json.data.perdaCadeiaFrio,\n            pesoEvaporadoKg: json.data.pesoEvaporadoKg,\n            perdaDesidratacao: json.data.perdaDesidratacao,\n            valorEstimadoDesperdicioEvitado: json.data.valorEstimadoDesperdicioEvitado,\n            detalhamento: json.data.detalhamento,\n          });\n          setBackendConectado(true);\n        }\n      } else {\n        setBackendConectado(false);\n      }\n    } catch {\n      setBackendConectado(false);\n    } finally {\n      setIsCalculandoApi(false);\n    }\n  };\n\n  useEffect(() => {\n    processarCalculo(pesoTotalKg, valorMedioKg, estadoMercadoria, custoDispositivo, viagensMes);\n  }, [pesoTotalKg, valorMedioKg, estadoMercadoria, custoDispositivo, viagensMes]);\n\n  const aplicarPreset = (tipo: \'carne-bovina\' | \'frango-exportacao\' | \'suino-resfriado\') => {\n    if (tipo === \'carne-bovina\') {\n      setPesoTotalKg(28000);\n      setValorMedioKg(34.00);\n      setEstadoMercadoria(\'resfriada\');\n    } else if (tipo === \'frango-exportacao\') {\n      setPesoTotalKg(24000);\n      setValorMedioKg(14.50);\n      setEstadoMercadoria(\'congelada\');\n    } else if (tipo === \'suino-resfriado\') {\n      setPesoTotalKg(22000);\n      setValorMedioKg(21.00);\n      setEstadoMercadoria(\'resfriada\');\n    }\n  };\n\n  const redefinirPadrao = () => {\n    setPesoTotalKg(25000);\n    setValorMedioKg(28.50);\n    setEstadoMercadoria(\'resfriada\');\n    setCustoDispositivo(2200);\n    setViagensMes(14);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Banner de Contexto Operacional */}\n      <div className=\"bg-white rounded-xl border border-slate-200/80 p-5 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200\">\n              Regra de Neg\303\263cio Homologada\n            </span>\n            {backendConectado ? (\n              <span className=\"inline-flex items-center gap-1.5 text-xs font-medium text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200\">\n                <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\"></span>\n                Back-end /api/calculadora-perdas ativo\n              </span>\n            ) : (\n              <span className=\"inline-flex items-center gap-1.5 text-xs font-medium text-amber-700 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200\">\n                <span className=\"w-2 h-2 rounded-full bg-amber-500\"></span>\n                Modo Offline\n              </span>\n            )}\n          </div>\n          <h1 className=\"text-xl md:text-2xl font-bold text-slate-900 mt-1.5\">\n            Calculadora Financeira de Mitiga\303\247\303\243o de Perdas Log\303\255sticas\n          </h1>\n          <p className=\"text-sm text-slate-600 mt-0.5\">\n            Calcule o desperd\303\255cio evitado pela ado\303\247\303\243o do dispositivo preditivo ColdTrack IoT na cadeia de transporte frigor\303\255fico.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2 self-stretch md:self-auto\">\n          <button\n            type=\"button\"\n            id=\"btn-redefinir\"\n            onClick={redefinirPadrao}\n            className=\"px-3 py-2 text-xs font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors flex items-center gap-1.5\"\n            title=\"Redefinir para valores padr\303\243o\"\n          >\n            <RotateCcw className=\"w-3.5 h-3.5\" />\n            Redefinir\n          </button>\n          <button\n            type=\"button\"\n            id=\"btn-info-tecnica\"\n            onClick={() => setExibirInfoTecnica(!exibirInfoTecnica)}\n            className=\"px-3 py-2 text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 rounded-lg transition-colors flex items-center gap-1.5 border border-blue-200\"\n          >\n            <HelpCircle className=\"w-3.5 h-3.5\" />\n            {exibirInfoTecnica ? \'Ocultar Fontes\' : \'Par\303\242metros & Fontes\'}\n          </button>\n        </div>\n      </div>\n\n      {/* Caixa Expans\303\255vel de Fontes e Regras */}\n      {exibirInfoTecnica && (\n        <div className=\"bg-slate-900 text-slate-100 rounded-xl p-5 shadow-md border border-slate-800 text-sm\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n            <h4 className=\"font-semibold text-white flex items-center gap-2\">\n              <ShieldCheck className=\"w-4 h-4 text-emerald-400\" />\n              Premissas Cient\303\255ficas e Normativas dos C\303\241lculos\n            </h4>\n            <span className=\"text-xs text-slate-400\">Diretrizes Log\303\255sticas & Agropecu\303\241rias</span>\n          </div>\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 mt-3\">\n            <div className=\"bg-slate-800/60 p-3 rounded-lg border border-slate-700/50\">\n              <span className=\"text-xs font-bold text-amber-400 uppercase tracking-wider block mb-1\">\n                Passo 2: Falha T\303\251rmica (12%)\n              </span>\n              <p className=\"text-xs text-slate-300 leading-relaxed\">\n                Estat\303\255sticas log\303\255sticas globais e nacionais confirmam que <strong>12% dos alimentos</strong> transportados sofrem descarte ou deprecia\303\247\303\243o severa exclusivamente pela perda de controle t\303\251rmico da carga.\n              </p>\n            </div>\n            <div className=\"bg-slate-800/60 p-3 rounded-lg border border-slate-700/50\">\n              <span className=\"text-xs font-bold text-blue-400 uppercase tracking-wider block mb-1\">\n                Passo 3: Desidrata\303\247\303\243o / Umidade (2%)\n              </span>\n              <p className=\"text-xs text-slate-300 leading-relaxed\">\n                M\303\251dia segura de <strong>2% de perda de massa por evapora\303\247\303\243o</strong> (faixa de 1% a 3%, somando 0,7%\342\200\2231,5% em c\303\242mara inicial com at\303\251 1% em estocagem/transporte prolongado fora do ponto de orvalho \303\263timo).\n              </p>\n            </div>\n            <div className=\"bg-slate-800/60 p-3 rounded-lg border border-slate-700/50\">\n              <span className=\"text-xs font-bold text-emerald-400 uppercase tracking-wider block mb-1\">\n                Mitiga\303\247\303\243o Preditiva IoT\n              </span>\n              <p className=\"text-xs text-slate-300 leading-relaxed\">\n                O sensor IoT com algoritmo preditivo antecipa anomalias higrot\303\251rmicas em at\303\251 <strong>45 minutos</strong> antes do ponto de dano celular, viabilizando interven\303\247\303\243o e salvando integralmente essa margem.\n              </p>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Grid Principal: Formul\303\241rio de Entrada (Esquerda) vs Resultado de Desperd\303\255cio Evitado (Direita) */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n        \n        {/* COLUNA 1: ENTRADAS DO USU\303\201RIO */}\n        <div className=\"lg:col-span-5 space-y-5\">\n          <div className=\"bg-white rounded-xl border border-slate-200 p-6 shadow-xs\">\n            <div className=\"flex items-center justify-between mb-4 pb-3 border-b border-slate-100\">\n              <h3 className=\"text-base font-bold text-slate-900 flex items-center gap-2\">\n                <Scale className=\"w-5 h-5 text-blue-600\" />\n                Dados da Carga & Opera\303\247\303\243o\n              </h3>\n              <span className=\"text-xs font-medium text-slate-500\">Par\303\242metros de Entrada</span>\n            </div>\n\n            {/* Presets R\303\241pidos */}\n            <div className=\"mb-5\">\n              <span className=\"text-xs font-semibold text-slate-600 uppercase tracking-wider block mb-2\">\n                Simula\303\247\303\265es T\303\255picas de Mercado:\n              </span>\n              <div className=\"grid grid-cols-3 gap-2\">\n                <button\n                  type=\"button\"\n                  id=\"preset-bovina\"\n                  onClick={() => aplicarPreset(\'carne-bovina\')}\n                  className=\"px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-medium text-slate-700 bg-slate-50 hover:bg-blue-50 hover:border-blue-300 hover:text-blue-800 transition-all text-center\"\n                >\n                  Boi Casado (Resfriado)\n                </button>\n                <button\n                  type=\"button\"\n                  id=\"preset-frango\"\n                  onClick={() => aplicarPreset(\'frango-exportacao\')}\n                  className=\"px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-medium text-slate-700 bg-slate-50 hover:bg-blue-50 hover:border-blue-300 hover:text-blue-800 transition-all text-center\"\n                >\n                  Frango Exp. (Congelado)\n                </button>\n                <button\n                  type=\"button\"\n                  id=\"preset-suino\"\n                  onClick={() => aplicarPreset(\'suino-resfriado\')}\n                  className=\"px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-medium text-slate-700 bg-slate-50 hover:bg-blue-50 hover:border-blue-300 hover:text-blue-800 transition-all text-center\"\n                >\n                  Su\303\255no (Resfriado)\n                </button>\n              </div>\n            </div>\n\n            <div className=\"space-y-4\">\n              {/* CAMPO 1: Peso Total da Carga (kg) */}\n              <div>\n                <div className=\"flex items-center justify-between mb-1.5\">\n                  <label htmlFor={pesoInputId} className=\"text-sm font-semibold text-slate-800 flex items-center gap-1.5\">\n                    <Scale className=\"w-4 h-4 text-slate-500\" />\n                    Peso Total da Carga (kg)\n                  </label>\n                  <span className=\"text-xs font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded\">\n                    {formatarNumeroBR(pesoTotalKg, 0)} kg\n                  </span>\n                </div>\n                <div className=\"relative\">\n                  <input\n                    id={pesoInputId}\n                    type=\"number\"\n                    min=\"100\"\n                    max=\"100000\"\n                    step=\"500\"\n                    value={pesoTotalKg || \'\'}\n                    onChange={(e) => setPesoTotalKg(Math.max(0, Number(e.target.value)))}\n                    className=\"w-full h-11 pl-3 pr-12 rounded-lg border border-slate-300 bg-slate-50/50 text-slate-900 font-semibold text-base focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-hidden transition\"\n                    placeholder=\"Ex: 25000\"\n                  />\n                  <span className=\"absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400\">\n                    KG\n                  </span>\n                </div>\n                <div className=\"mt-1.5\">\n                  <input\n                    type=\"range\"\n                    min=\"5000\"\n                    max=\"45000\"\n                    step=\"500\"\n                    value={pesoTotalKg}\n                    onChange={(e) => setPesoTotalKg(Number(e.target.value))}\n                    className=\"w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600\"\n                  />\n                  <div className=\"flex justify-between text-[10px] text-slate-400 font-medium mt-0.5\">\n                    <span>5.000 kg (VUC)</span>\n                    <span>25.000 kg (Carreta)</span>\n                    <span>45.000 kg (Bitrem)</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* CAMPO 2: Valor M\303\251dio por Quilo (R$/kg) */}\n              <div>\n                <div className=\"flex items-center justify-between mb-1.5\">\n                  <label htmlFor={valorInputId} className=\"text-sm font-semibold text-slate-800 flex items-center gap-1.5\">\n                    <DollarSign className=\"w-4 h-4 text-slate-500\" />\n                    Valor M\303\251dio da Mercadoria por Quilo (R$/kg)\n                  </label>\n                  <span className=\"text-xs font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded\">\n                    R$ {formatarNumeroBR(valorMedioKg, 2)}/kg\n                  </span>\n                </div>\n                <div className=\"relative\">\n                  <span className=\"absolute left-3 top-1/2 -translate-y-1/2 text-sm font-bold text-slate-500\">\n                    R$\n                  </span>\n                  <input\n                    id={valorInputId}\n                    type=\"number\"\n                    min=\"1\"\n                    max=\"1000\"\n                    step=\"0.50\"\n                    value={valorMedioKg || \'\'}\n                    onChange={(e) => setValorMedioKg(Math.max(0, Number(e.target.value)))}\n                    className=\"w-full h-11 pl-10 pr-12 rounded-lg border border-slate-300 bg-slate-50/50 text-slate-900 font-semibold text-base focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-hidden transition\"\n                    placeholder=\"Ex: 28.50\"\n                  />\n                  <span className=\"absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400\">\n                    /KG\n                  </span>\n                </div>\n                <div className=\"mt-1.5\">\n                  <input\n                    type=\"range\"\n                    min=\"5\"\n                    max=\"60\"\n                    step=\"0.5\"\n                    value={valorMedioKg}\n                    onChange={(e) => setValorMedioKg(Number(e.target.value))}\n                    className=\"w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600\"\n                  />\n                  <div className=\"flex justify-between text-[10px] text-slate-400 font-medium mt-0.5\">\n                    <span>R$ 5 (Aves/Mi\303\272dos)</span>\n                    <span>R$ 28 (Cortes Nobres)</span>\n                    <span>R$ 60+ (Especiais)</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* CAMPO 3: Seletor de Estado da Mercadoria */}\n              <div>\n                <label className=\"text-sm font-semibold text-slate-800 flex items-center justify-between mb-2\">\n                  <span className=\"flex items-center gap-1.5\">\n                    <Snowflake className=\"w-4 h-4 text-slate-500\" />\n                    Estado da Mercadoria\n                  </span>\n                  <span className=\"text-xs text-slate-500 font-normal\">\n                    Selecione o estado de conserva\303\247\303\243o\n                  </span>\n                </label>\n                \n                <div className=\"grid grid-cols-2 gap-3\" role=\"radiogroup\" aria-label=\"Estado da mercadoria\">\n                  <button\n                    type=\"button\"\n                    id=\"opt-resfriada\"\n                    onClick={() => setEstadoMercadoria(\'resfriada\')}\n                    className={`flex flex-col items-start p-3 rounded-xl border-2 transition-all text-left ${\n                      estadoMercadoria === \'resfriada\'\n                        ? \'border-blue-600 bg-blue-50/80 shadow-xs\'\n                        : \'border-slate-200 bg-white hover:border-slate-300\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between w-full mb-1\">\n                      <span className=\"flex items-center gap-1.5 text-sm font-bold text-slate-900\">\n                        <Droplets className={`w-4 h-4 ${estadoMercadoria === \'resfriada\' ? \'text-blue-600\' : \'text-slate-400\'}`} />\n                        Resfriada\n                      </span>\n                      {estadoMercadoria === \'resfriada\' ? (\n                        <CheckCircle2 className=\"w-4 h-4 text-blue-600\" />\n                      ) : (\n                        <span className=\"w-3.5 h-3.5 rounded-full border border-slate-300\"></span>\n                      )}\n                    </div>\n                    <span className=\"text-xs text-slate-600 leading-tight\">\n                      Carne in natura (0\302\260C a +4\302\260C). <strong className=\"text-blue-800 font-semibold\">Alta taxa de perda h\303\255drica</strong>.\n                    </span>\n                  </button>\n\n                  <button\n                    type=\"button\"\n                    id=\"opt-congelada\"\n                    onClick={() => setEstadoMercadoria(\'congelada\')}\n                    className={`flex flex-col items-start p-3 rounded-xl border-2 transition-all text-left ${\n                      estadoMercadoria === \'congelada\'\n                        ? \'border-blue-600 bg-blue-50/80 shadow-xs\'\n                        : \'border-slate-200 bg-white hover:border-slate-300\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between w-full mb-1\">\n                      <span className=\"flex items-center gap-1.5 text-sm font-bold text-slate-900\">\n                        <ThermometerSnowflake className={`w-4 h-4 ${estadoMercadoria === \'congelada\' ? \'text-blue-600\' : \'text-slate-400\'}`} />\n                        Congelada\n                      </span>\n                      {estadoMercadoria === \'congelada\' ? (\n                        <CheckCircle2 className=\"w-4 h-4 text-blue-600\" />\n                      ) : (\n                        <span className=\"w-3.5 h-3.5 rounded-full border border-slate-300\"></span>\n                      )}\n                    </div>\n                    <span className=\"text-xs text-slate-600 leading-tight\">\n                      Cargas a -18\302\260C. Risco de freezer burn e forma\303\247\303\243o de cristais.\n                    </span>\n                  </button>\n                </div>\n              </div>\n            </div>\n\n            {/* Configura\303\247\303\265es Adicionais de ROI (Opcional colaps\303\241vel / compacto) */}\n            <div className=\"mt-5 pt-4 border-t border-slate-100\">\n              <div className=\"grid grid-cols-2 gap-3 text-xs\">\n                <div>\n                  <label htmlFor={custoInputId} className=\"font-semibold text-slate-600 block mb-1\">\n                    Custo Dispositivo ColdTrack\n                  </label>\n                  <div className=\"relative\">\n                    <span className=\"absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 font-medium\">R$</span>\n                    <input\n                      id={custoInputId}\n                      type=\"number\"\n                      step=\"100\"\n                      value={custoDispositivo}\n                      onChange={(e) => setCustoDispositivo(Math.max(0, Number(e.target.value)))}\n                      className=\"w-full h-8 pl-8 pr-2 rounded border border-slate-200 text-xs font-semibold text-slate-800 bg-slate-50\"\n                    />\n                  </div>\n                </div>\n                <div>\n                  <label htmlFor={viagensInputId} className=\"font-semibold text-slate-600 block mb-1\">\n                    Viagens / M\303\252s por Ve\303\255culo\n                  </label>\n                  <input\n                    id={viagensInputId}\n                    type=\"number\"\n                    min=\"1\"\n                    max=\"100\"\n                    value={viagensMes}\n                    onChange={(e) => setViagensMes(Math.max(1, Number(e.target.value)))}\n                    className=\"w-full h-8 px-2.5 rounded border border-slate-200 text-xs font-semibold text-slate-800 bg-slate-50\"\n                  />\n                </div>\n              </div>\n            </div>\n\n          </div>\n\n          {/* Resumo Instant\303\242neo do Passo 1 */}\n          <div className=\"bg-slate-50 rounded-xl border border-slate-200/80 p-4\">\n            <div className=\"flex items-center justify-between text-xs text-slate-500 mb-1\">\n              <span className=\"font-semibold uppercase tracking-wider\">Passo 1: C\303\241lculo do Valor Bruto</span>\n              <span>{formatarNumeroBR(pesoTotalKg, 0)} kg &times; {formatarMoedaBRL(valorMedioKg)}/kg</span>\n            </div>\n            <div className=\"flex items-baseline justify-between\">\n              <span className=\"text-sm font-bold text-slate-800\">Valor Total da Carga:</span>\n              <span className=\"text-lg font-extrabold text-slate-900\">\n                {formatarMoedaBRL(resultado.valorTotalCarga)}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* COLUNA 2: EXIBI\303\207\303\203O DE RESULTADO E REGRAS DE NEG\303\223CIO */}\n        <div className=\"lg:col-span-7 space-y-5\">\n\n          {/* CARD PRINCIPAL (PASSO 4): VALOR ESTIMADO DE DESPERD\303\215CIO EVITADO */}\n          <div \n            id=\"card-desperdicio-evitado\"\n            className=\"bg-linear-to-br from-emerald-600 via-emerald-700 to-teal-800 text-white rounded-2xl p-6 md:p-7 shadow-lg shadow-emerald-900/15 relative overflow-hidden\"\n          >\n            {/* Elementos visuais de fundo */}\n            <div className=\"absolute -right-10 -bottom-10 w-48 h-48 rounded-full bg-white/5 pointer-events-none blur-xl\"></div>\n            <div className=\"absolute right-6 top-6 opacity-15\">\n              <ShieldCheck className=\"w-24 h-24\" />\n            </div>\n\n            <div className=\"relative z-10\">\n              <div className=\"flex items-center justify-between gap-2\">\n                <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white/15 text-emerald-100 backdrop-blur-xs border border-white/20\">\n                  <Sparkles className=\"w-3.5 h-3.5 text-yellow-300\" />\n                  Resultado da Mitiga\303\247\303\243o Preditiva\n                </span>\n                <span className=\"text-xs text-emerald-200 font-medium\">\n                  {isCalculandoApi ? \'Atualizando back-end...\' : \'Calculado por viagem\'}\n                </span>\n              </div>\n\n              {/* CHAMADA EXIGIDA NO PASSO 4 */}\n              <div className=\"mt-4\">\n                <div className=\"text-xs md:text-sm font-semibold text-emerald-100 uppercase tracking-wider\">\n                  Valor Estimado de Desperd\303\255cio Evitado\n                </div>\n                <div \n                  id=\"valor-estimado-desperdicio-evitado\"\n                  className=\"text-3xl md:text-5xl font-black tracking-tight text-white mt-1\"\n                >\n                  {formatarMoedaBRL(resultado.valorEstimadoDesperdicioEvitado)}\n                </div>\n                <p className=\"text-xs md:text-sm text-emerald-100/90 mt-1 font-medium\">\n                  Economia financeira direta assegurada pela preven\303\247\303\243o de falha t\303\251rmica e de desseca\303\247\303\243o por viagem.\n                </p>\n              </div>\n\n              {/* DETALHAMENTO EXIGIDO NO PASSO 4 */}\n              <div className=\"mt-6 pt-5 border-t border-white/15 grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                \n                {/* Parcela 1: Salvo da Quebra T\303\251rmica */}\n                <div className=\"bg-white/10 backdrop-blur-xs rounded-xl p-3.5 border border-white/15\">\n                  <div className=\"flex items-center justify-between text-xs text-emerald-200 font-medium mb-1\">\n                    <span className=\"flex items-center gap-1\">\n                      <Flame className=\"w-3.5 h-3.5 text-amber-300\" />\n                      Salvo da Quebra T\303\251rmica (12%)\n                    </span>\n                  </div>\n                  <div className=\"text-xl font-bold text-white\">\n                    {formatarMoedaBRL(resultado.detalhamento.salvoQuebraTermica)}\n                  </div>\n                  <div className=\"text-[11px] text-emerald-100/80 mt-0.5\">\n                    Preven\303\247\303\243o de quebra da cadeia do frio\n                  </div>\n                </div>\n\n                {/* Parcela 2: Salvo da Perda de Peso por Umidade */}\n                <div className=\"bg-white/10 backdrop-blur-xs rounded-xl p-3.5 border border-white/15\">\n                  <div className=\"flex items-center justify-between text-xs text-emerald-200 font-medium mb-1\">\n                    <span className=\"flex items-center gap-1\">\n                      <Droplets className=\"w-3.5 h-3.5 text-sky-300\" />\n                      Salvo da Perda de Peso (2%)\n                    </span>\n                  </div>\n                  <div className=\"text-xl font-bold text-white\">\n                    {formatarMoedaBRL(resultado.detalhamento.salvoDesidratacaoUmidade)}\n                  </div>\n                  <div className=\"text-[11px] text-emerald-100/80 mt-0.5\">\n                    {formatarNumeroBR(resultado.pesoEvaporadoKg, 1)} kg de peso n\303\243o evaporado\n                  </div>\n                </div>\n\n              </div>\n\n              {/* Retorno L\303\255quido Imediato */}\n              <div className=\"mt-4 flex flex-wrap items-center justify-between text-xs text-emerald-100 bg-black/15 rounded-lg px-3 py-2 border border-white/10\">\n                <span>\n                  Investimento no dispositivo: <strong>{formatarMoedaBRL(resultado.metricasComplementares.custoDispositivo)}</strong>\n                </span>\n                <span className=\"font-bold text-white\">\n                  Economia L\303\255quida na 1\302\252 viagem: +{formatarMoedaBRL(resultado.metricasComplementares.economiaLiquidaPrimeiraViagem)} ({formatarNumeroBR(resultado.metricasComplementares.roiMultiplicador, 1)}x de retorno)\n                </span>\n              </div>\n            </div>\n          </div>\n\n          {/* EVIDENCIA\303\207\303\203O ESPECIAL DA CARGA RESFRIADA (SOLICITADA NO PASSO 3) */}\n          {estadoMercadoria === \'resfriada\' ? (\n            <div \n              id=\"alerta-resfriada-evidenciado\"\n              className=\"bg-sky-50 border-2 border-sky-400/80 rounded-xl p-4.5 shadow-xs transition-all animate-fade-in\"\n            >\n              <div className=\"flex items-start gap-3\">\n                <div className=\"p-2 bg-sky-500 text-white rounded-lg shrink-0 mt-0.5 shadow-xs\">\n                  <Droplets className=\"w-5 h-5\" />\n                </div>\n                <div className=\"flex-1 min-w-0\">\n                  <div className=\"flex items-center justify-between flex-wrap gap-2 mb-1\">\n                    <h4 className=\"text-sm font-bold text-sky-950 flex items-center gap-1.5\">\n                      {resultado.destaqueResfriada.titulo}\n                    </h4>\n                    <span className=\"text-xs font-bold px-2 py-0.5 rounded bg-sky-200 text-sky-900 border border-sky-300\">\n                      Evapora\303\247\303\243o Cr\303\255tica Evitada\n                    </span>\n                  </div>\n                  <p className=\"text-xs text-sky-900/90 leading-relaxed\">\n                    {resultado.destaqueResfriada.descricao}\n                  </p>\n                  \n                  {/* M\303\251tricas destacadas do impacto da umidade */}\n                  <div className=\"mt-3 grid grid-cols-2 sm:grid-cols-3 gap-2 pt-2.5 border-t border-sky-200/80\">\n                    <div className=\"bg-white/80 rounded-md p-2 border border-sky-200\">\n                      <span className=\"text-[10px] uppercase font-bold text-sky-600 block\">Volume Evaporado</span>\n                      <span className=\"text-sm font-extrabold text-sky-950\">{formatarNumeroBR(resultado.pesoEvaporadoKg, 1)} kg</span>\n                      <span className=\"text-[10px] text-slate-500 block\">\303\241gua retida na carca\303\247a</span>\n                    </div>\n                    <div className=\"bg-white/80 rounded-md p-2 border border-sky-200\">\n                      <span className=\"text-[10px] uppercase font-bold text-sky-600 block\">Perda Financeira Evitada</span>\n                      <span className=\"text-sm font-extrabold text-sky-950\">{formatarMoedaBRL(resultado.perdaDesidratacao)}</span>\n                      <span className=\"text-[10px] text-slate-500 block\">dinheiro salvo de &quot;carne leve&quot;</span>\n                    </div>\n                    <div className=\"bg-white/80 rounded-md p-2 border border-sky-200 col-span-2 sm:col-span-1\">\n                      <span className=\"text-[10px] uppercase font-bold text-sky-600 block\">Quebra de Balan\303\247a</span>\n                      <span className=\"text-sm font-extrabold text-sky-950\">2,0% da carga</span>\n                      <span className=\"text-[10px] text-slate-500 block\">mitigado com umidade &gt;85%</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          ) : (\n            <div className=\"bg-slate-50 border border-slate-200 rounded-xl p-4 text-xs text-slate-600 flex items-start gap-3\">\n              <ThermometerSnowflake className=\"w-5 h-5 text-slate-500 shrink-0 mt-0.5\" />\n              <div>\n                <span className=\"font-bold text-slate-800 block mb-0.5\">\n                  Carga Congelada (-18\302\260C)\n                </span>\n                <p className=\"leading-relaxed\">\n                  Mesmo congelada, a quebra de 2% por sublima\303\247\303\243o e forma\303\247\303\243o de escarcha foi calculada em {formatarNumeroBR(resultado.pesoEvaporadoKg, 1)} kg ({formatarMoedaBRL(resultado.perdaDesidratacao)}). A integridade do inv\303\263lucro e temperatura est\303\241vel mant\303\252m o valor nominal.\n                </p>\n              </div>\n            </div>\n          )}\n\n          {/* DETALHAMENTO COMPARATIVO PASSO A PASSO */}\n          <div className=\"bg-white rounded-xl border border-slate-200 p-5 shadow-xs\">\n            <h4 className=\"text-sm font-bold text-slate-900 mb-3 flex items-center justify-between\">\n              <span>Demonstrativo da Mem\303\263ria de C\303\241lculo (Passo a Passo)</span>\n              <span className=\"text-xs font-normal text-slate-500\">Regras de Neg\303\263cio</span>\n            </h4>\n\n            <div className=\"divide-y divide-slate-100 text-xs\">\n              {/* Linha 1 */}\n              <div className=\"py-2.5 flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"w-5 h-5 rounded-full bg-slate-100 text-slate-700 font-bold flex items-center justify-center text-[11px]\">1</span>\n                  <div>\n                    <span className=\"font-semibold text-slate-800\">Valor Total da Carga</span>\n                    <p className=\"text-slate-500\">{formatarNumeroBR(pesoTotalKg, 0)} kg &times; {formatarMoedaBRL(valorMedioKg)}</p>\n                  </div>\n                </div>\n                <div className=\"text-right font-bold text-slate-900\">\n                  {formatarMoedaBRL(resultado.valorTotalCarga)}\n                </div>\n              </div>\n\n              {/* Linha 2 */}\n              <div className=\"py-2.5 flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"w-5 h-5 rounded-full bg-amber-100 text-amber-800 font-bold flex items-center justify-center text-[11px]\">2</span>\n                  <div>\n                    <span className=\"font-semibold text-slate-800\">Perda por Quebra da Cadeia do Frio (T\303\251rmica)</span>\n                    <p className=\"text-slate-500\">12% fixo sobre o Valor Total da Carga</p>\n                  </div>\n                </div>\n                <div className=\"text-right\">\n                  <div className=\"font-bold text-amber-700\">{formatarMoedaBRL(resultado.perdaCadeiaFrio)}</div>\n                  <span className=\"text-[10px] text-slate-400\">12,0% do valor bruto</span>\n                </div>\n              </div>\n\n              {/* Linha 3 */}\n              <div className=\"py-2.5 flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"w-5 h-5 rounded-full bg-blue-100 text-blue-800 font-bold flex items-center justify-center text-[11px]\">3</span>\n                  <div>\n                    <span className=\"font-semibold text-slate-800\">Perda F\303\255sica por Desidrata\303\247\303\243o (Umidade)</span>\n                    <p className=\"text-slate-500\">2% do peso ({formatarNumeroBR(resultado.pesoEvaporadoKg, 1)} kg) &times; {formatarMoedaBRL(valorMedioKg)}/kg</p>\n                  </div>\n                </div>\n                <div className=\"text-right\">\n                  <div className=\"font-bold text-blue-700\">{formatarMoedaBRL(resultado.perdaDesidratacao)}</div>\n                  <span className=\"text-[10px] text-slate-400\">2,0% por evapora\303\247\303\243o h\303\255drica</span>\n                </div>\n              </div>\n\n              {/* Linha Total 4 */}\n              <div className=\"py-3 flex items-center justify-between bg-slate-50/70 -mx-5 px-5 rounded-b-xl\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"w-5 h-5 rounded-full bg-emerald-100 text-emerald-800 font-bold flex items-center justify-center text-[11px]\">4</span>\n                  <div>\n                    <span className=\"font-bold text-slate-900\">Total do Desperd\303\255cio Evitado (T\303\251rmica + Umidade)</span>\n                    <p className=\"text-emerald-700 font-medium\">14% de prote\303\247\303\243o total sobre o lote</p>\n                  </div>\n                </div>\n                <div className=\"text-right\">\n                  <div className=\"text-base font-black text-emerald-700\">\n                    {formatarMoedaBRL(resultado.valorEstimadoDesperdicioEvitado)}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Proje\303\247\303\265es de Escala da Frota */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div className=\"bg-white rounded-xl border border-slate-200 p-4 shadow-xs\">\n              <div className=\"flex items-center justify-between text-xs text-slate-500 mb-1\">\n                <span className=\"font-semibold text-slate-700 flex items-center gap-1.5\">\n                  <TrendingUp className=\"w-4 h-4 text-emerald-600\" />\n                  Proje\303\247\303\243o Mensal ({viagensMes} viagens)\n                </span>\n              </div>\n              <div className=\"text-xl font-bold text-slate-900 mt-1\">\n                {formatarMoedaBRL(resultado.metricasComplementares.desperdicioMensalEstimado)}\n              </div>\n              <p className=\"text-[11px] text-slate-500 mt-0.5\">\n                Economia acumulada por m\303\252s com o dispositivo operando em rota cont\303\255nua.\n              </p>\n            </div>\n\n            <div className=\"bg-white rounded-xl border border-slate-200 p-4 shadow-xs\">\n              <div className=\"flex items-center justify-between text-xs text-slate-500 mb-1\">\n                <span className=\"font-semibold text-slate-700 flex items-center gap-1.5\">\n                  <BarChart3 className=\"w-4 h-4 text-blue-600\" />\n                  Proje\303\247\303\243o Anual de Prote\303\247\303\243o\n                </span>\n              </div>\n              <div className=\"text-xl font-bold text-blue-700 mt-1\">\n                {formatarMoedaBRL(resultado.metricasComplementares.desperdicioAnualEstimado)}\n              </div>\n              <p className=\"text-[11px] text-slate-500 mt-0.5\">\n                Capital total protegido de desperd\303\255cio invis\303\255vel em 1 ano de safra/log\303\255stica.\n              </p>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    }
