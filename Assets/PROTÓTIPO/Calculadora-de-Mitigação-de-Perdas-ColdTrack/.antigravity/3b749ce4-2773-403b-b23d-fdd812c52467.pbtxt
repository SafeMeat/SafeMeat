    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { \n  Calculator, \n  Truck, \n  Snowflake, \n  Bell, \n  User, \n  Radio,\n  ShieldCheck\n} from \'lucide-react\';\n\ninterface HeaderNavProps {\n  abaAtiva: \'calculadora\' | \'telemetria\';\n  onTrocarAba: (aba: \'calculadora\' | \'telemetria\') => void;\n}\n\nexport const HeaderNav: React.FC<HeaderNavProps> = ({ abaAtiva, onTrocarAba }) => {\n  return (\n    <header className=\"bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-40 shadow-md\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16\">\n          \n          {/* Marca / Identidade do ColdTrack */}\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center shadow-md shadow-blue-500/20\">\n              <Snowflake className=\"w-6 h-6 text-white\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-black text-lg tracking-tight text-white\">ColdTrack IoT</span>\n                <span className=\"text-[10px] font-bold uppercase tracking-wider bg-blue-500/20 text-blue-400 px-1.5 py-0.5 rounded border border-blue-500/30\">\n                  Cadeia do Frio\n                </span>\n              </div>\n              <p className=\"text-[11px] text-slate-400\">\n                Dispositivo Preditivo de Monitoramento Log\303\255stico\n              </p>\n            </div>\n          </div>\n\n          {/* Abas de Navega\303\247\303\243o Principal */}\n          <nav className=\"hidden md:flex items-center gap-1 bg-slate-800/80 p-1 rounded-xl border border-slate-700/60\">\n            <button\n              type=\"button\"\n              id=\"tab-calculadora\"\n              onClick={() => onTrocarAba(\'calculadora\')}\n              className={`flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all ${\n                abaAtiva === \'calculadora\'\n                  ? \'bg-blue-600 text-white shadow-xs\'\n                  : \'text-slate-300 hover:text-white hover:bg-slate-700/50\'\n              }`}\n            >\n              <Calculator className=\"w-3.5 h-3.5\" />\n              Calculadora de Mitiga\303\247\303\243o de Perdas\n            </button>\n\n            <button\n              type=\"button\"\n              id=\"tab-telemetria\"\n              onClick={() => onTrocarAba(\'telemetria\')}\n              className={`flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all ${\n                abaAtiva === \'telemetria\'\n                  ? \'bg-blue-600 text-white shadow-xs\'\n                  : \'text-slate-300 hover:text-white hover:bg-slate-700/50\'\n              }`}\n            >\n              <Truck className=\"w-3.5 h-3.5\" />\n              Telemetria de Frota & Alertas\n              <span className=\"w-2 h-2 rounded-full bg-amber-400\"></span>\n            </button>\n          </nav>\n\n          {/* Perfil & Status */}\n          <div className=\"flex items-center gap-3\">\n            <div className=\"hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-800/70 border border-slate-700/60 text-xs text-slate-300\">\n              <div className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\"></div>\n              <span>Sensores LTE-M</span>\n            </div>\n\n            <div className=\"flex items-center gap-2.5 pl-2 border-l border-slate-800\">\n              <div className=\"w-8 h-8 rounded-full bg-blue-600/30 border border-blue-500/40 text-blue-400 flex items-center justify-center font-bold text-xs\">\n                TE\n              </div>\n              <div className=\"hidden lg:block text-left text-xs leading-tight\">\n                <span className=\"font-semibold text-slate-200 block\">Transportes Exemplo</span>\n                <span className=\"text-[11px] text-slate-400\">Gestor de Frota</span>\n              </div>\n            </div>\n          </div>\n\n        </div>\n      </div>\n\n      {/* Navega\303\247\303\243o Mobile */}\n      <div className=\"md:hidden flex border-t border-slate-800 bg-slate-900/95 px-4 py-2 gap-2\">\n        <button\n          type=\"button\"\n          onClick={() => onTrocarAba(\'calculadora\')}\n          className={`flex-1 py-2 text-xs font-semibold rounded-lg flex items-center justify-center gap-1.5 ${\n            abaAtiva === \'calculadora\' ? \'bg-blue-600 text-white\' : \'text-slate-400 bg-slate-800\'\n          }`}\n        >\n          <Calculator className=\"w-3.5 h-3.5\" />\n          Calculadora\n        </button>\n        <button\n          type=\"button\"\n          onClick={() => onTrocarAba(\'telemetria\')}\n          className={`flex-1 py-2 text-xs font-semibold rounded-lg flex items-center justify-center gap-1.5 ${\n            abaAtiva === \'telemetria\' ? \'bg-blue-600 text-white\' : \'text-slate-400 bg-slate-800\'\n          }`}\n        >\n          <Truck className=\"w-3.5 h-3.5\" />\n          Frota IoT\n          <span className=\"w-1.5 h-1.5 rounded-full bg-amber-400\"></span>\n        </button>\n      </div>\n    </header>\n  );\n};\n"
    }
